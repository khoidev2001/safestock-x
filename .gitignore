# ============================================================
# BÍ MẬT — không bao giờ commit
# ============================================================
.env
.env.demo
.env.local
.env.*.local
.env.bak-*
# Máy chủ thứ hai (các xã lân cận) — cùng loại bí mật với .env.
.env.lan-can
**/.env
!.env.example
!.env.demo.example

# Khóa ký APK. Lộ ra là KHÔNG thu hồi được: Android không cho đổi
# khóa ký mà vẫn giữ được đường cập nhật cho máy đã cài.
*.keystore
keystore.properties

# ============================================================
# PHỤ THUỘC — dựng lại theo CAI-DAT.md
# ============================================================
# node_modules: `pnpm install`, khóa phiên bản trong pnpm-lock.yaml
node_modules/

# .venv: `pip install -r requirements.txt`.
# Bản PyTorch CUDA nặng hơn 3 GB, có tệp vượt giới hạn 100 MB của GitHub.
.venv/
venv/

# ============================================================
# KẾT QUẢ BIÊN DỊCH — dựng lại bằng các lệnh build
# ============================================================
dist/
build/
.next/
# Thư mục build tách biệt cho instance frontend chạy song song (demo/preflight)
# qua NEXT_DIST_DIR — là artifact sinh ra, không commit.
.next-*/
out/
release/
.expo/
.gradle/
.cxx/
.test-out*/
*.tsbuildinfo
__pycache__/
*.pyc
.pytest_cache/
coverage/
.turbo/

# ============================================================
# KHÁC
# ============================================================
*.log
.DS_Store

# Vùng làm việc của trợ lý AI: worktree tạm, ghi chú phiên. Sinh ra tại máy, không chia sẻ.
.claude/
prisma/*.db

# Báo cáo xuất cục bộ; dữ liệu có thể chứa thông tin vận hành và được sinh lại khi cần
/apps/backend/baocao-*.xlsx
anh-thuyet-minh/

# ============================================================
# KHOÁ FIREBASE — KHÔNG BAO GIỜ COMMIT
# ============================================================
# google-services.json gắn app Android với dự án Firebase; service account key là
# khoá ký, ai cầm được nó thì gửi thông báo giả danh hệ thống tới mọi máy đã cài.
apps/mobile/google-services.json
**/fcm-service-account*.json
**/*service-account*.json

# Bản sao Firebase mà Gradle đọc — cùng lý do với file gốc ở apps/mobile.
apps/mobile/android/app/google-services.json
