# Copy to .env at repo root. Docker + api đọc chung.
POSTGRES_USER=safestock
POSTGRES_PASSWORD=safestock_dev
POSTGRES_DB=safestock
# Đổi port nếu 5432/6379 đã bị project khác chiếm (docker ps)
POSTGRES_PORT=55433
REDIS_PORT=56380

# api dùng — port phải khớp POSTGRES_PORT / REDIS_PORT ở trên
DATABASE_URL=postgresql://safestock:safestock_dev@localhost:55433/safestock?schema=public
REDIS_URL=redis://localhost:56380
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
API_PORT=3100

# ai-service / mission compiler (thêm khi tới lát Mission)
# Provider pluggable: ollama (default, local, 0đ) | gemini (cloud) | claude (trả phí)
AI_PROVIDER=ollama
# Key từ Google AI Studio (aistudio.google.com/apikey), dạng AIzaSy...
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_URL=http://localhost:11434
CLAUDE_API_KEY=
AI_SERVICE_URL=http://localhost:8000

# GeoService — khoảng cách/ETA kho→điểm nạn. Không key → luôn Haversine (offline, đủ dùng).
# Có key → dùng thêm Google Routes, tự chặn ở GEO_MONTHLY_CAP để không vượt free tier 10.000/tháng.
GOOGLE_MAPS_API_KEY=
GEO_MONTHLY_CAP=8500
GEO_ASSUMED_SPEED_KMH=30

# Email cảnh báo sự cố (SMTP) — khi sự cố MỚI bật, AI giải thích rồi gửi mail tới ALERT_EMAIL_TO.
# ALERT_EMAIL_ENABLED=false (mặc định) hoặc thiếu SMTP_* → app BỎ QUA gửi mail (không lỗi).
# ALERT_EMAIL_FROM = địa chỉ hiển thị người gửi; tên hiển thị luôn là "Ứng phó nhanh" (đặt trong code).
#
# CÁCH A — Resend (khuyến nghị, gửi từ domain riêng alert@ungphonhanh.life):
#  - Đăng ký resend.com (free 3.000 mail/tháng) → verify domain ungphonhanh.life (thêm DNS ở Cloudflare)
#    → Dashboard → API Keys → tạo key (dạng re_xxx).
#  - SMTP_HOST=smtp.resend.com · SMTP_PORT=465 · SMTP_USER=resend · SMTP_PASS=<API key re_xxx>
#  - ALERT_EMAIL_FROM=alert@ungphonhanh.life (phải thuộc domain đã verify).
#
# CÁCH B — Gmail (nhanh, nhưng địa chỉ là @gmail.com):
#  - Bật 2FA → App Password (myaccount.google.com/apppasswords, 16 ký tự, bỏ dấu cách) → SMTP_PASS.
#  - SMTP_HOST=smtp.gmail.com · SMTP_PORT=465 · SMTP_USER=<gmail> · ALERT_EMAIL_FROM để trống → dùng SMTP_USER.
#
# KHÔNG commit API key / App Password — chỉ đặt trong .env cục bộ.
ALERT_EMAIL_ENABLED=false
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=
SMTP_USER=resend
SMTP_PASS=
ALERT_EMAIL_FROM=alert@ungphonhanh.life
ALERT_EMAIL_TO=

# Backup Supabase (BE-Bp5) — cron 17:00 dump DB → Supabase Storage, giữ 3 bản.
# Thiếu 2 biến dưới → app bỏ qua lịch backup (không lỗi). Cách lấy (free tier):
#  1. Tạo tài khoản + project tại https://supabase.com (Free plan đủ dùng).
#  2. Storage → New bucket → đặt tên "db-backups" (hoặc đổi SUPABASE_BACKUP_BUCKET).
#  3. Project Settings → API: copy "Project URL" → SUPABASE_URL;
#     copy "service_role" secret (KHÔNG phải anon key) → SUPABASE_SERVICE_KEY.
#     service_role bỏ qua RLS để upload/xóa backup — GIỮ BÍ MẬT, chỉ để ở server.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BACKUP_BUCKET=db-backups
# Tên container Postgres để pg_dump chạy bên trong (mặc định safestock_postgres).
POSTGRES_CONTAINER=safestock_postgres
