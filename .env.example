# Copy to .env at repo root. Docker + api đọc chung.
POSTGRES_USER=safestock
POSTGRES_PASSWORD=safestock_dev
POSTGRES_DB=safestock
# Đổi port nếu 5432/6379 đã bị project khác chiếm (docker ps)
POSTGRES_PORT=55433
REDIS_PORT=56380

# api dùng — port phải khớp POSTGRES_PORT / REDIS_PORT ở trên
DATABASE_URL=postgresql://safestock:safestock_dev@localhost:55433/safestock?schema=public
REDIS_URL=redis://localhost:56380
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
API_PORT=3100

# ai-service / mission compiler (thêm khi tới lát Mission)
# Provider pluggable: gemini (default, free) | ollama (local, 0đ) | claude (trả phí)
AI_PROVIDER=gemini
GEMINI_API_KEY=
OLLAMA_MODEL=qwen2.5
OLLAMA_URL=http://localhost:11434
CLAUDE_API_KEY=
