# Máy chủ THỨ HAI — các xã lân cận của Đồng Xuân.
#
# Chép tệp này thành `.env.lan-can` ở gốc kho mã rồi điền hai bí mật JWT và khoá
# chia sẻ liên xã. Cùng mã nguồn với máy chủ chính, chỉ khác ba thứ: cơ sở dữ
# liệu, cổng, và danh bạ xã lân cận trỏ ngược về Đồng Xuân.
#
#   pnpm be:db:lan-can    # dựng bảng + seed cho cơ sở dữ liệu này
#   pnpm be:dev:lan-can   # chạy ở cổng 3101
#
# KHOÁ CHIA SẺ phải TRÙNG với khoá mà .env của Đồng Xuân khai cho xã bên này:
# nó vừa là vé vào cửa, vừa là thứ bên nhận dùng để nhận ra ai đang gọi.

POSTGRES_USER=safestock
POSTGRES_PASSWORD=safestock_dev
# POSTGRES_DB chỉ dùng cho docker-compose của máy chủ CHÍNH; máy chủ này dùng chung
# container Postgres đó và trỏ vào một cơ sở dữ liệu khác qua DATABASE_URL bên dưới.
POSTGRES_DB=safestock
# Đổi port nếu 5432/6379 đã bị project khác chiếm (docker ps)
POSTGRES_PORT=55433
REDIS_PORT=56380

# api dùng — port phải khớp POSTGRES_PORT / REDIS_PORT ở trên
DATABASE_URL=postgresql://safestock:safestock_dev@localhost:55433/safestock_lan_can?schema=public
REDIS_URL=redis://localhost:56380
JWT_ACCESS_SECRET=sinh_chuoi_ngau_nhien_it_nhat_16_ky_tu
JWT_REFRESH_SECRET=sinh_chuoi_ngau_nhien_khac_it_nhat_16_ky_tu
API_PORT=3101
# Origin web được phép gọi API (CORS). Khi set biến này thì nó THAY THẾ danh sách
# dev mặc định → phải liệt kê đủ: 3200 = frontend Next.js, 8081 = Expo web (mobile).
CORS_ALLOWED_ORIGINS=http://localhost:3200,http://localhost:8081,http://localhost:5173,http://127.0.0.1:3200,http://127.0.0.1:8081,http://127.0.0.1:5173

# ai-service / mission compiler (thêm khi tới lát Mission)
# Provider pluggable: gemini (default, free) | ollama (local, 0đ) | claude (trả phí)
AI_PROVIDER=ollama
# Key từ Google AI Studio (aistudio.google.com/apikey), dạng AIzaSy...
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_URL=http://localhost:11434
CLAUDE_API_KEY=
AI_SERVICE_URL=http://localhost:8000

# GeoService — khoảng cách/ETA kho→điểm nạn. Không key → luôn Haversine (offline, đủ dùng).
# Có key → dùng thêm Google Routes, tự chặn ở GEO_MONTHLY_CAP để không vượt free tier 10.000/tháng.
GOOGLE_MAPS_API_KEY=
GEO_MONTHLY_CAP=8500
GEO_ASSUMED_SPEED_KMH=30

# OSRM chạy local trong private LAN. Bỏ trống => UI hiển thị rõ chưa tính được tuyến,
# không vẽ đường thẳng giả. Graph version phải khớp manifest trong infrastructure/osrm/data.
LOCAL_ROUTING_URL=http://localhost:5000
LOCAL_ROUTING_GRAPH_VERSION=dong-xuan-2026-07-27
OSRM_BIND_ADDRESS=127.0.0.1
OSRM_PORT=5000

# ===== Email (mã xác minh + cảnh báo sự cố) =====
# MAIL_DEV_LOG_CODES=true: chưa có SMTP thì mã 6 số IN RA LOG backend để chạy thử được
# luồng. Chỉ dùng khi phát triển — production bỏ dòng này đi (code cũng tự chặn khi
# NODE_ENV=production). Điền SMTP_* bên dưới rồi xoá dòng này là mã đi tới hộp thư thật.
MAIL_DEV_LOG_CODES=false
SMTP_HOST=smtp.gmail.com
SMTP_USER=
SMTP_PASS=


# Gmail: bật 2FA → tạo App Password 16 ký tự (myaccount.google.com/apppasswords), bỏ dấu cách.
#   SMTP_HOST=smtp.gmail.com · SMTP_PORT=465 · SMTP_USER=<gmail của bạn> · SMTP_PASS=<app password>
# Resend: SMTP_HOST=smtp.resend.com · SMTP_PORT=465 · SMTP_USER=resend · SMTP_PASS=<API key re_xxx>
SMTP_PORT=465
SMTP_SECURE=
ALERT_EMAIL_FROM=
# Bật kênh email cảnh báo sự cố (khác với mã xác minh — mã luôn gửi được khi có SMTP).
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_TO=

# Tin nhắn SMS — mã 6 số xác minh SỐ ĐIỆN THOẠI cá nhân trong tab Tài khoản (mobile).
# Số chỉ vào hồ sơ sau khi mã gửi tới chính máy đó được nhập đúng: đây là số người trực
# bấm để gọi khi kho cần chi viện, số gõ nhầm một chữ chỉ lộ ra lúc không còn ai rảnh tra lại.
#
# ĐƯỜNG GỬI THEO TỪNG NHÀ MẠNG. Brandname ở Việt Nam ký với từng nhà mạng, nên mỗi mạng
# cấu hình được một đường riêng; số thuộc mạng chưa ký thì rơi về đường mặc định
# (SMS_PROVIDER_URL — thường là cổng tổng hợp như eSMS, FPT SMS, Twilio).
# Nhà mạng nhận ra từ BA SỐ ĐẦU (xem apps/backend/src/sms/vn-carriers.ts):
#   Viettel      032 033 034 035 036 037 038 039 086 096 097 098
#   VinaPhone    081 082 083 084 085 088 091 094
#   MobiFone     070 076 077 078 079 089 090 093
#   Vietnamobile 052 056 058 092
#   Gmobile      059 099
#   iTelecom     087   ·  Wintel 055   (mạng ảo, ký hợp đồng riêng)
# Số cố định (024, 028, 0257…) bị từ chối ngay: không nhận được tin nhắn.
#
# Mỗi đường có ba biến, đều tuỳ chọn — thiếu _URL nghĩa là chưa cấu hình đường đó:
#   SMS_PROVIDER_URL / _TOKEN / _SENDER              → mặc định, dùng cho mọi số
#   SMS_PROVIDER_VIETTEL_URL / _TOKEN / _SENDER      → riêng Viettel
#   SMS_PROVIDER_VINAPHONE_… MOBIFONE_… VIETNAMOBILE_… GMOBILE_… ITELECOM_… WINTEL_…
# _SENDER là brandname hiện ở chỗ người gửi trong tin nhắn.
#
# CHƯA ĐẤU NHÀ CUNG CẤP NÀO: phần gọi API nằm ở `dispatch` trong verification-sms.service.ts.
# Mỗi bên một kiểu ký (eSMS truyền ApiKey/SecretKey trên query, Twilio dùng Basic auth +
# form encode), nên chỉ cài đúng bên đã ký hợp đồng vào một chỗ duy nhất đó.
#
# Chỉ dùng khi phát triển: chưa cấu hình đường nào thì mã 6 số được IN RA LOG backend và
# hiện thẳng trên màn hình, để chạy thử được luồng. Code tự chặn khi NODE_ENV=production.
SMS_DEV_LOG_CODES=true
SMS_PROVIDER_URL=
SMS_PROVIDER_TOKEN=
SMS_PROVIDER_SENDER=
SMS_PROVIDER_VIETTEL_URL=
SMS_PROVIDER_VINAPHONE_URL=
SMS_PROVIDER_MOBIFONE_URL=
SMS_PROVIDER_VIETNAMOBILE_URL=
SMS_PROVIDER_GMOBILE_URL=
SMS_PROVIDER_ITELECOM_URL=
SMS_PROVIDER_WINTEL_URL=

# ── Mượn — trả liên xã: danh bạ máy chủ của các xã lân cận ────────────────────
# Đây là máy chủ của CÁC XÃ LÂN CẬN. Nó chỉ cần biết đường về Đồng Xuân (cổng
# 3100). Khoá phải trùng với khoá Đồng Xuân khai cho các xã ở đây.
COMMUNE_PEER_DONG_XUAN=Đồng Xuân|http://127.0.0.1:3100|khoa-chia-se-phai-trung-voi-.env-cua-dong-xuan
