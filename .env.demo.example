# Copy this file to .env.demo. Never reuse operational credentials.
SAFESTOCK_RUNTIME=demo
SAFESTOCK_ENV_FILE=.env.demo
STACK_NAME=safestock_demo
BIND_ADDRESS=127.0.0.1

POSTGRES_USER=safestock_demo
POSTGRES_PASSWORD=change_me_demo_database_password
POSTGRES_DB=safestock_demo
POSTGRES_PORT=55434
DATABASE_URL=postgresql://safestock_demo:change_me_demo_database_password@localhost:55434/safestock_demo?schema=public
POSTGRES_CONTAINER=safestock_demo_postgres

REDIS_PORT=56381
REDIS_URL=redis://localhost:56381

JWT_ACCESS_SECRET=change_me_demo_access_secret_at_least_32_chars
JWT_REFRESH_SECRET=change_me_demo_refresh_secret_at_least_32_chars
SIMULATION_MUTATION_ENABLED=true
API_PORT=3110

# Demo reuses the stateless local AI service. External notifications/backups stay disabled.
AI_SERVICE_URL=http://localhost:8000
LOCAL_ROUTING_URL=http://localhost:5000
LOCAL_ROUTING_GRAPH_VERSION=
# Keep verified contact values in the ignored .env.demo file, never in this template.
COMMUNE_CONTACT_DONG_XUAN=
NEIGHBOR_CONTACT_XUAN_THO=
NEIGHBOR_CONTACT_TUY_AN_BAC=
NEIGHBOR_CONTACT_TUY_AN_TAY=
NEIGHBOR_CONTACT_XUAN_LANH=
NEIGHBOR_CONTACT_PHU_MO=
NEIGHBOR_CONTACT_XUAN_PHUOC=
ALERT_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BACKUP_BUCKET=
