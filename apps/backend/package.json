{
  "name": "@safestock/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "prisma:generate": "prisma generate",
    "prisma:diff": "prisma migrate diff --from-schema-datasource prisma/schema.prisma --to-schema-datamodel prisma/schema.prisma --script",
    "prisma:push": "prisma db push --skip-generate",
    "prisma:backfill-mission-preparations": "ts-node prisma/backfill-mission-warehouse-preparations.ts",
    "prisma:backfill-hamlets": "ts-node prisma/backfill-hamlets.ts",
    "prisma:backfill-inventory-transactions": "ts-node prisma/backfill-inventory-transaction-warehouses.ts",
    "prisma:backfill-audit-scope": "ts-node prisma/backfill-audit-scope.ts",
    "prisma:backfill-notification-organizations": "ts-node prisma/backfill-notification-organizations.ts",
    "prisma:studio": "prisma studio",
    "seed": "ts-node prisma/seed.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "jest --config test/jest-e2e.config.js --runInBand",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/platform-socket.io": "^11.1.28",
    "@nestjs/serve-static": "^5.0.5",
    "@nestjs/websockets": "^11.1.28",
    "@prisma/client": "^5.20.0",
    "@safestock/scenario-definitions": "workspace:*",
    "@safestock/shared-types": "workspace:*",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.80.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.5",
    "fast-xml-parser": "^5.10.1",
    "nodemailer": "^9.0.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.0",
    "unzipper": "^0.12.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.28",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.16.10",
    "@types/nodemailer": "^6.4.16",
    "@types/unzipper": "^0.10.11",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.1",
    "jest": "^29.7.0",
    "prisma": "^5.20.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
