// SafeStock X — schema cốt lõi (Nền móng #0).
// Bảng Readiness / Mission / Simulator / Incident thêm ở lát tương ứng.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  WAREHOUSE
  RESCUE
  ADMIN
}

enum ItemStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
  DAMAGED
  EXPIRING_SOON
  INSPECTION_OVERDUE
  MISPLACED
  UNKNOWN
  INACCESSIBLE
}

enum TransactionType {
  IMPORT
  EXPORT
  TRANSFER
  RETURN
  ADJUST
  LOAN_OUT_INTERXA // cho xã khác mượn
  LOAN_IN          // mượn từ xã khác
}

// Nguồn giao dịch — độ lệch giữa nguồn feed vào "độ tin cậy" Readiness
enum TransactionSource {
  SCAN
  BULK
  LOADCELL
  RFID
  MANUAL
}

// Trạng thái vật tư 2 CHIỀU độc lập (C-minus)
enum ItemCondition {
  NEW         // mới
  USED        // cũ, đã dùng
  NEEDS_CHECK // cần kiểm tra
  DAMAGED     // hư hỏng
}

enum CirculationStatus {
  IN_STOCK  // trong kho
  ON_LOAN   // đang mượn — vẫn thuộc kho, KHÔNG tính mất
  RETURNED  // vừa hoàn, chờ kiểm tra
}

enum LoanStatus {
  ON_LOAN
  PARTIALLY_RETURNED
  CLOSED
}

model Organization {
  id         String      @id @default(cuid())
  name       String
  createdAt  DateTime    @default(now())
  users      User[]
  warehouses Warehouse[]
}

model User {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  email          String       @unique
  passwordHash   String
  fullName       String
  role           UserRole     @default(WAREHOUSE)
  createdAt      DateTime     @default(now())
  transactions   InventoryTransaction[]
}

model Warehouse {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  name           String
  location       String?
  distanceKm     Float           @default(0) // khoảng cách tới trung tâm/điểm sự cố — Mission ưu tiên gần
  createdAt      DateTime        @default(now())
  zones          WarehouseZone[]
}

// Kho lân cận (xã khác) — NHẬP TAY, AI đọc để gợi ý mượn liên xã. KHÔNG sync DB thật (#30)
model NeighborWarehouse {
  id          String   @id @default(cuid())
  warehouseId String // kho của mình (tham chiếu)
  name        String // tên xã lân cận
  distanceKm  Float
  contactInfo String? // sđt/bộ đàm liên hệ
  summary     Json // tồn kho tóm tắt nhập tay: [{sku, name, quantity}]
  updatedAt   DateTime @updatedAt

  @@index([warehouseId])
}

model WarehouseZone {
  id          String    @id @default(cuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  code        String // ví dụ "A", "B"
  name        String
  shelves     Shelf[]

  @@unique([warehouseId, code])
}

model Shelf {
  id        String        @id @default(cuid())
  zoneId    String
  zone      WarehouseZone @relation(fields: [zoneId], references: [id])
  code      String // ví dụ "A1", "A2"
  isBlocked Boolean       @default(false) // lối đi bị chặn — Readiness "khả năng tiếp cận"
  isLocked  Boolean       @default(false) // bị khóa / thiếu quyền
  batches   ItemBatch[]
  devices   VirtualDevice[]

  @@unique([zoneId, code])
}

model ItemCategory {
  id    String @id @default(cuid())
  name  String @unique
  unit  String // đơn vị: chiếc, bộ, lít...
  items Item[]
}

model Item {
  id           String       @id @default(cuid())
  categoryId   String
  category     ItemCategory @relation(fields: [categoryId], references: [id])
  name         String
  sku          String       @unique
  consumable   Boolean      @default(false) // true=tiêu hao (nước/pin, xuất=mất); false=tái sử dụng (áo phao, xuất=mượn)
  unitWeightKg Float?       // khối lượng đơn vị — loadcell suy số lượng (Bp1)
  createdAt    DateTime     @default(now())
  batches      ItemBatch[]
}

model ItemBatch {
  id           String            @id @default(cuid())
  itemId       String
  item         Item              @relation(fields: [itemId], references: [id])
  shelfId      String?
  shelf        Shelf?            @relation(fields: [shelfId], references: [id])
  batchCode    String
  quantity     Int               @default(0)
  status       ItemStatus        @default(AVAILABLE) // giữ tương thích; sẽ dùng condition+circulation
  condition    ItemCondition     @default(NEW)     // chiều 1: tình trạng vật lý
  circulation  CirculationStatus @default(IN_STOCK) // chiều 2: lưu hành
  expiryDate   DateTime?
  inspectedAt  DateTime?
  createdAt    DateTime          @default(now())
  transactions InventoryTransaction[]
  counts       InventoryCount[]
  loans        LoanRecord[]

  @@unique([itemId, batchCode])
}

// Phiếu mượn (#17) — vật tư consumable=false. Giữ ItemBatch nguyên, phân mảnh nằm ở phiếu.
model LoanRecord {
  id              String     @id @default(cuid())
  batchId         String
  batch           ItemBatch  @relation(fields: [batchId], references: [id])
  quantity        Int // số mượn
  borrowedByUserId String?
  missionId       String?
  status          LoanStatus @default(ON_LOAN)
  returnedOk      Int        @default(0) // hoàn tốt → USED về kho
  returnedDamaged Int        @default(0) // hoàn hỏng → DAMAGED
  lost            Int        @default(0) // mất → trừ tổng kho
  borrowedAt      DateTime   @default(now())
  closedAt        DateTime?

  @@index([batchId, status])
}

// Kiểm kê thực tế — so với quantity hệ thống cho Readiness (khả dụng SL + độ tin cậy)
model InventoryCount {
  id         String    @id @default(cuid())
  batchId    String
  batch      ItemBatch @relation(fields: [batchId], references: [id])
  countedQty Int
  userId     String?
  note       String?
  countedAt  DateTime  @default(now())

  @@index([batchId, countedAt])
}

model InventoryTransaction {
  id        String            @id @default(cuid())
  batchId   String
  batch     ItemBatch         @relation(fields: [batchId], references: [id])
  userId    String
  user      User              @relation(fields: [userId], references: [id])
  type      TransactionType
  source    TransactionSource @default(SCAN) // nguồn — feed dataReliability
  quantity  Int
  note      String?
  createdAt DateTime          @default(now())
}

// Audit log — mọi thao tác quan trọng ghi lại bất biến (PRD NFR-03)
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())
}

// ===== Phase B: Sensor Simulator (mô phỏng lớp cảm biến) =====

enum VirtualDeviceType {
  LOADCELL
  TEMPERATURE
  HUMIDITY
  SMOKE
  DOOR
  RFID_GATEWAY
  CAMERA_AI
  POWER
  GATEWAY
}

enum SimRunStatus {
  IDLE
  PLAYING
  PAUSED
  DONE
}

model VirtualDevice {
  id          String            @id @default(cuid())
  warehouseId String
  zoneId      String?
  shelfId     String?
  shelf       Shelf?            @relation(fields: [shelfId], references: [id])
  type        VirtualDeviceType
  code        String // vd "scale_shelf_A1"
  unit        String // kg, °C, %, bool...
  // Trạng thái current — Readiness đọc cái này, không query MAX(timestamp)
  currentValue Float?
  online       Boolean          @default(true)
  updatedAt    DateTime         @updatedAt
  events       SensorEvent[]

  @@unique([warehouseId, code])
  @@index([warehouseId, type])
}

model SensorEvent {
  id          String        @id @default(cuid())
  deviceId    String
  device      VirtualDevice @relation(fields: [deviceId], references: [id])
  warehouseId String
  zoneId      String?
  eventType   String // WEIGHT_CHANGED, DOOR_OPEN, VISION_DETECTION...
  value       Float
  unit        String
  quality     Float         @default(1.0) // 0..1
  scenarioId  String?
  runId       String?
  createdAt   DateTime      @default(now())

  @@index([warehouseId, createdAt])
  @@index([runId])
}

model SimulationScenario {
  id          String          @id @default(cuid())
  key         String          @unique // "flood_01", "suspected_loss"...
  name        String
  description String?
  // Định nghĩa event list (offsetMs, deviceCode, value...) — nguồn sự thật ở packages/scenario-definitions
  definition  Json
  runs        SimulationRun[]
}

model SimulationRun {
  id          String             @id @default(cuid())
  scenarioId  String
  scenario    SimulationScenario @relation(fields: [scenarioId], references: [id])
  warehouseId String
  seed        Int                @default(42)
  speed       Int                @default(1) // 1 | 10
  status      SimRunStatus       @default(IDLE)
  cursorMs    Int                @default(0) // con trỏ timeline-scrubber
  startedAt   DateTime?
  createdAt   DateTime           @default(now())

  @@index([warehouseId, status])
}

// ===== Phase C: Readiness Score =====

// Cấp độ đối tượng được chấm điểm (4 cấp: PRD 3.2)
enum ReadinessTargetType {
  ITEM_BATCH
  SHELF
  ZONE
  WAREHOUSE
}

// Điểm sẵn sàng đã tính (cache) cho 1 đối tượng ở 1 thời điểm.
// Recalc (C1) ghi đè bản mới nhất theo (targetType, targetId).
model ReadinessScore {
  id          String              @id @default(cuid())
  warehouseId String
  targetType  ReadinessTargetType
  targetId    String
  score       Int // 0-100 tổng
  computedAt  DateTime            @default(now())
  components  ReadinessComponent[]
  recommendations ReadinessRecommendation[]

  @@unique([targetType, targetId])
  @@index([warehouseId, targetType])
}

// Breakdown: điểm từng thành phần (6 thành phần) + lý do trừ điểm.
model ReadinessComponent {
  id       String         @id @default(cuid())
  scoreId  String
  score    ReadinessScore @relation(fields: [scoreId], references: [id], onDelete: Cascade)
  key      String // quantityAvailability | itemCondition | expiry | accessibility | environment | dataReliability
  value    Int // 0-100 thành phần
  weight   Float // trọng số áp dụng lúc tính
  reasons  String[] // lý do bị trừ điểm

  @@index([scoreId])
}

// Cấu hình trọng số + ngưỡng công thức, chỉnh được theo từng kho (configurable).
// Rỗng → dùng READINESS_CONFIG mặc định (có disclaimer "tham khảo nghiên cứu").
model ReadinessRule {
  id          String   @id @default(cuid())
  warehouseId String   @unique
  weights     Json // { quantityAvailability, itemCondition, ... } tổng = 1
  thresholds  Json // { expiry, environment, dataReliability... }
  updatedAt   DateTime @updatedAt
}

// Ngưỡng hành động 4 vùng (C3) — chỉnh được mỗi kho.
model ReadinessThreshold {
  id          String   @id @default(cuid())
  warehouseId String   @unique
  ready       Int      @default(80) // >= ready: 🟢
  attention   Int      @default(70) // >= attention: 🟡
  degraded    Int      @default(50) // >= degraded: 🟠; dưới: 🔴
  updatedAt   DateTime @updatedAt
}

// Đề xuất cải thiện sinh từ nguyên nhân trừ điểm (C2).
model ReadinessRecommendation {
  id        String         @id @default(cuid())
  scoreId   String
  score     ReadinessScore @relation(fields: [scoreId], references: [id], onDelete: Cascade)
  component String // thành phần liên quan
  message   String // vd "Kiểm tra 3 bộ sơ cứu sắp hết hạn ở kệ B1"
  createdAt DateTime       @default(now())

  @@index([scoreId])
}
