// Ứng phó nhanh — schema cốt lõi (Nền móng #0).
// Bảng Readiness / Mission / Simulator / Incident thêm ở lát tương ứng.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// WAREHOUSE kiêm luôn vai trưởng thôn: cùng một người giữ kho và báo tình huống
// của thôn mình, nên không tách thành hai tài khoản.
enum UserRole {
  WAREHOUSE
  RESCUE
  ADMIN
}

enum ItemStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
  DAMAGED
  EXPIRING_SOON
  INSPECTION_OVERDUE
  MISPLACED
  UNKNOWN
  INACCESSIBLE
}

enum TransactionType {
  IMPORT
  EXPORT
  TRANSFER
  RETURN
  ADJUST
  COUNT
  CONDITION
  LOAN_OUT_INTERXA // cho xã khác mượn
  LOAN_IN // mượn từ xã khác
}

// Nguồn giao dịch — độ lệch giữa nguồn feed vào "độ tin cậy" Readiness
enum TransactionSource {
  SCAN
  BULK
  LOADCELL
  RFID
  MANUAL
}

// Trạng thái vật tư 2 CHIỀU độc lập (C-minus)
enum ItemCondition {
  NEW // mới
  USED // cũ, đã dùng
  NEEDS_CHECK // cần kiểm tra
  DAMAGED // hư hỏng
}

enum CirculationStatus {
  IN_STOCK // trong kho
  ON_LOAN // đang mượn — vẫn thuộc kho, KHÔNG tính mất
  RETURNED // vừa hoàn, chờ kiểm tra
}

enum LoanStatus {
  ON_LOAN
  PARTIALLY_RETURNED
  CLOSED
}

model Organization {
  id                String                @id @default(cuid())
  name              String
  createdAt         DateTime              @default(now())
  users             User[]
  warehouses        Warehouse[]
  hamlets           Hamlet[]
  notifications     Notification[]
  interCommuneLoans InterCommuneLoan[]
  rescueHoldings    RescueSupplyHolding[]
}

model User {
  id                          String                        @id @default(cuid())
  organizationId              String
  organization                Organization                  @relation(fields: [organizationId], references: [id])
  email                       String                        @unique
  passwordHash                String
  fullName                    String
  phone                       String?
  notificationEmail           String?
  // Chỉ email đã xác minh bằng mã 6 số mới được nhận cảnh báo sự cố.
  notificationEmailVerifiedAt DateTime?
  avatarUrl                   String?
  role                        UserRole                      @default(WAREHOUSE)
  // Super admin = ADMIN kèm quyền quản trị tài khoản cấp cao. CỐ TÌNH không tách
  // thành một giá trị UserRole mới: mọi tính năng còn lại phải giống hệt ADMIN
  // (thông báo lọc theo recipientRole, ROLE_PERMISSIONS, luồng nhiệm vụ, app mobile),
  // thêm role mới là super admin rơi ra khỏi tất cả những chỗ đó cùng một lúc.
  isSuperAdmin                Boolean                       @default(false)
  // GIỮ LẠI cho tương thích, KHÔNG còn dùng để xoay refresh token.
  //
  // Số xoay giờ nằm ở từng phiên (`UserSession.tokenVersion`). Đếm ở mức người
  // dùng chỉ đúng khi mỗi người có duy nhất một thiết bị: web gia hạn phiên là
  // refresh token của điện thoại chết theo, dù hai bên là hai phiên độc lập.
  tokenVersion                Int                           @default(0)
  // Số thứ tự PHIÊN — đòn bẩy "thu hồi TẤT CẢ", không phải "đăng nhập lần nữa".
  //
  // Chỉ tăng khi thật sự cần đá mọi thiết bị ra cùng lúc: đổi mật khẩu, đổi
  // quyền, hoặc người dùng chủ động thoát khỏi mọi nơi. ĐĂNG NHẬP MỚI KHÔNG
  // TĂNG SỐ NÀY — đăng nhập trên web không phải là lý do để đuổi cái điện thoại
  // đang cầm trong tay ra ngoài, mà đó chính là chuyện đã xảy ra khi luồng đăng
  // nhập còn tăng nó.
  sessionVersion              Int                           @default(0)
  // Scope kho: null = phụ trách toàn xã (kho tổng); có giá trị = trưởng thôn CHỈ quản kho này.
  warehouseId                 String?
  warehouse                   Warehouse?                    @relation(fields: [warehouseId], references: [id])
  createdAt                   DateTime                      @default(now())
  transactions                InventoryTransaction[]
  reports                     MonthlyStockReport[]
  missionPreparations         MissionWarehousePreparation[]
  missionRequestsAccepted     MissionWarehouseRequest[]     @relation("MissionWarehouseRequestAcceptedBy")
  missionRequestsPrepared     MissionWarehouseRequest[]     @relation("MissionWarehouseRequestPreparedBy")
  missionRequestsPickedUp     MissionWarehouseRequest[]     @relation("MissionWarehouseRequestPickedUpBy")
  analysisSnapshots           MissionAnalysisSnapshot[]     @relation("MissionAnalysisActor")
  missionsApproved            Mission[]                     @relation("MissionApprovedBy")
  fieldUpdates                MissionFieldUpdate[]          @relation("MissionFieldUpdateActor")
  sensorSubmissions           SensorSubmission[]
  emailVerifications          EmailVerification[]
  phoneVerifications          PhoneVerification[]
  sessions                    UserSession[]
  requirementDecisions        MissionRequirement[]          @relation("MissionRequirementDecidedBy")
  rescueHoldingsConfirmed     RescueSupplyHolding[]         @relation("RescueSupplyHoldingConfirmedBy")
}

/// Một lần đăng nhập trên MỘT thiết bị. Web và điện thoại của cùng một người là
/// hai dòng khác nhau, xoay refresh token độc lập.
///
/// Vì sao cần bảng riêng: xoay refresh token đòi một bộ đếm tăng dần để phát hiện
/// token bị lấy cắp dùng lại. Bộ đếm ấy trước đây nằm trên chính người dùng, nên
/// hai thiết bị dùng chung một bộ đếm và giành nhau — thiết bị nào gia hạn trước
/// thì token của thiết bị kia thành cũ và bị chối. Mỗi phiên một bộ đếm thì cả
/// hai cùng xoay được, mà tính chất "một refresh token chỉ dùng đúng một lần" vẫn
/// còn nguyên trong phạm vi từng phiên.
model UserSession {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Số xoay của RIÊNG phiên này.
  tokenVersion Int       @default(0)
  createdAt    DateTime  @default(now())
  // Lượt gia hạn gần nhất — để biết phiên nào còn sống mà dọn phiên bỏ quên.
  lastUsedAt   DateTime  @default(now())
  // Thu hồi bằng cách ĐÁNH DẤU chứ không xoá dòng: còn đọc được là phiên này đã
  // bị chấm dứt lúc nào, thay vì một khoảng trống không giải thích được.
  revokedAt    DateTime?

  @@index([userId])
  @@index([userId, revokedAt])
}

// Mã 6 số dùng cho hai việc khác nhau, tách bằng `purpose` để mã xin cho việc này
// không xác minh hộ được việc kia.
enum EmailVerificationPurpose {
  NOTIFICATION_EMAIL // email cảnh báo của chính người đang đăng nhập
  ADMIN_ACCOUNT // email của tài khoản ADMIN mà super admin đang tạo
  PASSWORD_RESET // đặt lại mật khẩu khi quên, gửi tới email đã xác minh của tài khoản
}

// Mã 6 số xác minh email cá nhân nhận cảnh báo. Lưu hash chứ không lưu mã trần:
// đọc được DB vẫn không tự xác minh hộ được email của người khác.
model EmailVerification {
  id         String                   @id @default(cuid())
  userId     String
  user       User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email      String
  purpose    EmailVerificationPurpose @default(NOTIFICATION_EMAIL)
  codeHash   String
  expiresAt  DateTime
  attempts   Int                      @default(0)
  consumedAt DateTime?
  // Chỉ đóng dấu khi mã được nhập ĐÚNG. Khác consumedAt: mã bị thay bằng mã mới hoặc
  // bị huỷ cũng có consumedAt. Hạn mức chống spam chỉ đếm mã KHÔNG có verifiedAt —
  // xác minh trót lọt nghĩa là người nhận có thật, không phải hành vi cần chặn.
  verifiedAt DateTime?
  createdAt  DateTime                 @default(now())

  @@index([userId, purpose, createdAt])
}

// Mã 6 số gửi tới SỐ ĐIỆN THOẠI, để chốt rằng số vừa nhập là số người dùng cầm máy.
//
// Bảng riêng chứ không dùng chung EmailVerification: cột ở đó tên là `email` và mọi chỗ
// đọc nó đều hiểu là hộp thư. Nhét số điện thoại vào đấy thì mọi truy vấn sau này đều
// phải nhớ "trừ trường hợp purpose là số điện thoại" — một cái bẫy đặt sẵn.
//
// Số điện thoại là thứ người trực gọi khi cần chi viện gấp. Số gõ nhầm một chữ trông y
// hệt số đúng, và chỉ lộ ra vào đúng lúc không ai còn thời gian tra lại — nên số chỉ
// được ghi vào hồ sơ sau khi mã gửi tới chính máy đó được nhập lại.
model PhoneVerification {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Số đã chuẩn hoá (chỉ chữ số và dấu + đầu), đúng dạng đã gửi tin nhắn tới.
  phone      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  // Chỉ đóng dấu khi mã được nhập ĐÚNG — hạn mức chống spam chỉ đếm mã chưa xác minh.
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt])
}

enum WarehouseKind {
  CENTRAL // kho tổng — trung tâm hành chính xã
  HAMLET // kho thôn — mỗi thôn 1 kho nhỏ
}

model Warehouse {
  id                  String                        @id @default(cuid())
  organizationId      String
  organization        Organization                  @relation(fields: [organizationId], references: [id])
  name                String
  location            String?
  kind                WarehouseKind                 @default(HAMLET) // kho tổng hay kho thôn
  communeId           String                        @default("default-commune") // nhóm kho cùng xã — AI query cả cụm
  lat                 Float? // toạ độ ghim tay (không geocode)
  lng                 Float?
  distanceKm          Float                         @default(0) // fallback thủ công khi chưa có lat/lng
  createdAt           DateTime                      @default(now())
  zones               WarehouseZone[]
  leaders             User[] // trưởng thôn scope kho này
  reports             MonthlyStockReport[]
  missions            Mission[]                     @relation("MissionSourceWarehouse")
  missionPreparations MissionWarehousePreparation[]
  missionRequests     MissionWarehouseRequest[]
  sensorSubmissions   SensorSubmission[]
  deviceCredentials   DeviceCredential[]
  alertEmailOutboxes  AlertEmailOutbox[]
  interCommuneLoans   InterCommuneLoan[]
  rescueHoldings      RescueSupplyHolding[]
}

// Thôn/điểm ứng phó do ADMIN cấu hình trước. Marker này độc lập với marker kho.
// Tên chuẩn hóa/alias chỉ dùng để resolve địa danh deterministic trong đúng org+xã.
model Hamlet {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  communeId      String       @default("default-commune")
  name           String
  normalizedName String
  aliases        String[]     @default([])
  lat            Float?
  lng            Float?
  verified       Boolean      @default(false)
  verifiedAt     DateTime?
  verifiedById   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  missions       Mission[]

  @@unique([organizationId, communeId, normalizedName])
  @@index([organizationId, communeId])
}

enum ReportStatus {
  PENDING // trưởng thôn gửi, chờ admin xã duyệt
  APPROVED // admin duyệt → đã áp reconcile vào tồn
  REJECTED // admin từ chối
}

// Báo cáo kiểm kê tháng của kho thôn (BE Phase-thôn Luồng 2): trưởng thôn upload Excel
// → PENDING → admin xã duyệt → áp reconcile từng dòng. rows = snapshot Excel đã parse.
model MonthlyStockReport {
  id                String       @id @default(cuid())
  warehouseId       String
  warehouse         Warehouse    @relation(fields: [warehouseId], references: [id])
  submittedByUserId String
  submittedBy       User         @relation(fields: [submittedByUserId], references: [id])
  period            String // "YYYY-MM"
  status            ReportStatus @default(PENDING)
  rows              Json // [{sku, itemName, quantity, unit, expiryDate?, condition?, note?}]
  note              String?
  approvedByUserId  String?
  approvedAt        DateTime?
  createdAt         DateTime     @default(now())

  @@index([warehouseId, period])
}

// Kho lân cận (xã khác) — NHẬP TAY, AI đọc để gợi ý mượn liên xã. KHÔNG sync DB thật (#30)
model NeighborWarehouse {
  id          String   @id @default(cuid())
  warehouseId String // kho của mình (tham chiếu)
  name        String // tên xã lân cận
  distanceKm  Float
  contactInfo String? // sđt/bộ đàm liên hệ
  summary     Json // tồn kho tóm tắt nhập tay: [{sku, name, quantity}]
  updatedAt   DateTime @updatedAt

  @@index([warehouseId])
}

model WarehouseZone {
  id          String    @id @default(cuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  code        String // ví dụ "A", "B"
  name        String
  shelves     Shelf[]

  @@unique([warehouseId, code])
}

model Shelf {
  id       String          @id @default(cuid())
  zoneId   String
  zone     WarehouseZone   @relation(fields: [zoneId], references: [id])
  code     String // ví dụ "A1", "A2"
  isLocked Boolean         @default(false) // bị khóa / thiếu quyền
  batches  ItemBatch[]
  devices  VirtualDevice[]

  @@unique([zoneId, code])
}

model ItemCategory {
  id    String @id @default(cuid())
  name  String @unique
  unit  String // đơn vị: chiếc, bộ, lít...
  items Item[]
}

model Item {
  id           String       @id @default(cuid())
  categoryId   String
  category     ItemCategory @relation(fields: [categoryId], references: [id])
  name         String
  sku          String       @unique
  consumable   Boolean      @default(false) // true=tiêu hao (nước/pin, xuất=mất); false=tái sử dụng (áo phao, xuất=mượn)
  unitWeightKg Float? // khối lượng đơn vị — loadcell suy số lượng (Bp1)
  createdAt    DateTime     @default(now())
  batches      ItemBatch[]
}

model ItemBatch {
  id           String                 @id @default(cuid())
  itemId       String
  item         Item                   @relation(fields: [itemId], references: [id])
  shelfId      String?
  shelf        Shelf?                 @relation(fields: [shelfId], references: [id])
  batchCode    String
  quantity     Int                    @default(0)
  status       ItemStatus             @default(AVAILABLE) // giữ tương thích; sẽ dùng condition+circulation
  condition    ItemCondition          @default(NEW) // chiều 1: tình trạng vật lý
  circulation  CirculationStatus      @default(IN_STOCK) // chiều 2: lưu hành
  expiryDate   DateTime?
  inspectedAt  DateTime?
  createdAt    DateTime               @default(now())
  transactions InventoryTransaction[]
  counts       InventoryCount[]
  loans        LoanRecord[]

  @@unique([itemId, batchCode])
}

// Phiếu mượn (#17) — vật tư consumable=false. Giữ ItemBatch nguyên, phân mảnh nằm ở phiếu.
model LoanRecord {
  id               String     @id @default(cuid())
  batchId          String
  batch            ItemBatch  @relation(fields: [batchId], references: [id])
  quantity         Int // số mượn
  borrowedByUserId String?
  missionId        String?
  status           LoanStatus @default(ON_LOAN)
  returnedOk       Int        @default(0) // hoàn tốt → USED về kho
  returnedDamaged  Int        @default(0) // hoàn hỏng → DAMAGED
  lost             Int        @default(0) // mất → trừ tổng kho
  borrowedAt       DateTime   @default(now())
  closedAt         DateTime?

  @@index([batchId, status])
}

// Kiểm kê thực tế — so với quantity hệ thống cho Readiness (khả dụng SL + độ tin cậy)
model InventoryCount {
  id         String    @id @default(cuid())
  batchId    String
  batch      ItemBatch @relation(fields: [batchId], references: [id])
  countedQty Int
  userId     String?
  note       String?
  countedAt  DateTime  @default(now())

  @@index([batchId, countedAt])
}

model InventoryTransaction {
  id              String            @id @default(cuid())
  batchId         String
  batch           ItemBatch         @relation(fields: [batchId], references: [id])
  userId          String
  user            User              @relation(fields: [userId], references: [id])
  type            TransactionType
  source          TransactionSource @default(SCAN) // nguồn — feed dataReliability
  quantity        Int
  // Additive ledger semantics: legacy `quantity` remains the business event
  // amount; these fields make stock reconstruction unambiguous.
  beforeQuantity  Int?
  afterQuantity   Int?
  quantityDelta   Int?
  note            String?
  // Warehouse snapshots preserve ledger ownership after a batch moves.
  warehouseId     String?
  fromWarehouseId String?
  toWarehouseId   String?
  createdAt       DateTime          @default(now())

  @@index([warehouseId, createdAt])
  @@index([fromWarehouseId, createdAt])
  @@index([toWarehouseId, createdAt])
}

// Audit log — mọi thao tác quan trọng ghi lại bất biến (PRD NFR-03)
model AuditLog {
  id             String   @id @default(cuid())
  actorId        String?
  organizationId String?
  warehouseId    String?
  correlationId  String?
  action         String
  entity         String
  entityId       String?
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([warehouseId, createdAt])
  @@index([correlationId])
}

// ===== Phase B: Sensor Simulator (mô phỏng lớp cảm biến) =====

enum VirtualDeviceType {
  LOADCELL
  TEMPERATURE
  HUMIDITY
  SMOKE
  DOOR
  RFID_GATEWAY
  CAMERA_AI
  POWER
  GATEWAY
}

// Nguồn sinh ra số liệu. KHÔNG rẽ nhánh xử lý theo trường này: nó chỉ phục vụ
// hiển thị và truy vết. Cảm biến thật và thiết bị mô phỏng đi chung một đường ống.
enum TelemetrySource {
  OPERATOR // người vận hành xác nhận giá trị trên desktop
  HARDWARE // gateway/cảm biến tự gửi
}

// Khoá của một gateway phần cứng. Thiết bị không có tài khoản người dùng; nó
// xác thực bằng khoá riêng, bị thu hồi độc lập, và chỉ gửi được cho đúng kho.
model DeviceCredential {
  id          String             @id @default(cuid())
  warehouseId String
  warehouse   Warehouse          @relation(fields: [warehouseId], references: [id])
  code        String // vd "gateway_kho_trung_tam"
  name        String
  tokenPrefix String             @unique // phần công khai, dùng để tra cứu
  tokenHash   String // bcrypt của phần bí mật — không lưu token gốc
  createdAt   DateTime           @default(now())
  lastSeenAt  DateTime?
  revokedAt   DateTime?
  submissions SensorSubmission[]

  @@unique([warehouseId, code])
}

model VirtualDevice {
  id                      String            @id @default(cuid())
  warehouseId             String
  zoneId                  String?
  shelfId                 String?
  shelf                   Shelf?            @relation(fields: [shelfId], references: [id])
  type                    VirtualDeviceType
  code                    String // vd "scale_shelf_A1"
  unit                    String // kg, °C, %, bool...
  online                  Boolean           @default(true)
  // Mốc số liệu gần nhất thực sự nhận được. Im lặng quá lâu là một sự cố, không
  // phải trạng thái bình thường — xem quy tắc DEVICE_SILENT.
  lastSeenAt              DateTime?
  // Chu kỳ báo mong đợi (giây). null = không giám sát im lặng cho thiết bị này.
  expectedIntervalSeconds Int?
  updatedAt               DateTime          @updatedAt
  events                  SensorEvent[]

  @@unique([warehouseId, code])
  @@index([warehouseId, type])
}

// Một lô số liệu đã được xác nhận: người vận hành bấm gửi, hoặc gateway phần cứng
// đẩy lên. Đây là boundary chống gửi trùng và giữ mốc thời gian thật của phép đo,
// không phải bảng giữ trạng thái IoT hiện hành.
model SensorSubmission {
  id                  String            @id @default(cuid())
  idempotencyKey      String            @unique
  payloadHash         String
  warehouseId         String
  warehouse           Warehouse         @relation(fields: [warehouseId], references: [id])
  source              TelemetrySource   @default(OPERATOR)
  // Đúng một trong hai được đặt: người xác nhận, hoặc thiết bị đã xác thực.
  submittedByUserId   String?
  submittedBy         User?             @relation(fields: [submittedByUserId], references: [id])
  submittedByDeviceId String?
  submittedByDevice   DeviceCredential? @relation(fields: [submittedByDeviceId], references: [id])
  observedAt          DateTime
  receivedAt          DateTime          @default(now())
  policyVersion       String
  events              SensorEvent[]
  incidents           Incident[]

  @@index([warehouseId, observedAt])
  @@index([submittedByUserId, receivedAt])
  @@index([submittedByDeviceId, receivedAt])
}

model SensorEvent {
  id           String            @id @default(cuid())
  submissionId String?
  submission   SensorSubmission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  deviceId     String
  device       VirtualDevice     @relation(fields: [deviceId], references: [id])
  warehouseId  String
  zoneId       String?
  eventType    String // WEIGHT_CHANGED, DOOR_OPEN, VISION_DETECTION...
  value        Float
  unit         String
  quality      Float             @default(1.0) // 0..1
  // Mốc operator xác nhận; createdAt là thời điểm backend ghi nhận event.
  observedAt   DateTime          @default(now())
  createdAt    DateTime          @default(now())

  @@unique([submissionId, deviceId])
  @@index([warehouseId, createdAt])
  @@index([warehouseId, observedAt])
}

// ===== Phase C: Readiness Score =====

// Cấu hình trọng số + ngưỡng công thức, chỉnh được theo từng kho (configurable).
// Rỗng → dùng READINESS_CONFIG mặc định (có disclaimer "tham khảo nghiên cứu").
model ReadinessRule {
  id          String   @id @default(cuid())
  warehouseId String   @unique
  weights     Json // { quantityAvailability, itemCondition, ... } tổng = 1
  thresholds  Json // { expiry, environment, dataReliability... }
  updatedAt   DateTime @updatedAt
}

// Ngưỡng hành động 4 vùng (C3) — chỉnh được mỗi kho.
model ReadinessThreshold {
  id          String   @id @default(cuid())
  warehouseId String   @unique
  ready       Int      @default(80) // >= ready: 🟢
  attention   Int      @default(70) // >= attention: 🟡
  degraded    Int      @default(50) // >= degraded: 🟠; dưới: 🔴
  updatedAt   DateTime @updatedAt
}

// ===== Phase D: Mission-to-Kit =====

enum MissionStatus {
  DRAFT // bản tham mưu: mới có số lượng cần dùng, ADMIN đang rà soát
  // Đã gửi lực lượng hiện trường, chờ họ chốt từng món lấy bao nhiêu từ kho.
  //
  // CỐ TÌNH không tái dùng `PENDING_RESCUE` của luồng cũ: mọi nơi đọc trạng thái
  // đó đều coi nhiệm vụ là "đã duyệt và phát hành" — bộ lọc `published` ở
  // `listMissionsPage`, `missionIsPublished` và `completedStepIndex` trên web,
  // nhãn "Đã nhận · chờ kho" trên điện thoại. Mượn lại giá trị cũ là nói dối ở
  // sáu chỗ cùng lúc mà không chỗ nào báo lỗi biên dịch.
  PENDING_FIELD_DECISION
  // Hiện trường đã chốt xong số cần lấy; chờ ADMIN lập kế hoạch rồi phát hành.
  FIELD_DECIDED
  PENDING_RESCUE // (cũ) đã gửi, chờ cứu hộ xác nhận lấy
  RESCUE_CONFIRMED // (cũ) cứu hộ đã xác nhận
  PENDING_WAREHOUSE // chờ kho chuẩn bị + xuất
  READY // kho đã chuẩn bị xong, sẵn sàng giao
  APPROVED // (cũ, giữ tương thích)
  IN_PROGRESS // đang thực hiện
  COMPLETED // hoàn thành
  REJECTED // đội cứu hộ từ chối (kèm lý do), chờ admin xử lý
  DEFERRED // admin tiếp nhận đơn từ chối → tạm hoãn, sửa + gửi lại sau
  CANCELLED // admin huỷ nhiệm vụ (kèm lý do) — kết thúc luồng
}

// Kết quả giao vật tư tới hiện trường — đội cứu hộ xác nhận khi hoàn tất.
enum DeliveryOutcome {
  DELIVERED // giao đủ theo phương án
  PARTIAL // giao được một phần (thiếu/hỏng/không tiếp cận hết)
  FAILED // không giao được (đường tắc, điểm nạn di dời…)
}

/// Lực lượng hiện trường quyết gì với MỘT món trong bản tham mưu.
///
/// Ba lựa chọn chứ không phải một con số, vì "lấy hết" và "lấy đúng bằng số cần"
/// nhìn giống nhau lúc nhập nhưng khác nhau lúc ADMIN đọc lại: cái đầu là đồng ý
/// với bản tham mưu, cái sau là một con số người ta tự gõ ra.
enum PickupDecision {
  TAKE_ALL // lấy toàn bộ số bản tham mưu ghi
  TAKE_PARTIAL // chỉ lấy một phần (kèm số lượng)
  TAKE_NONE // không cần lấy từ kho
}

/// Dòng vật tư này do định mức sinh ra hay do ADMIN tự thêm khi rà soát.
///
/// Cần phân biệt vì lượt tính lại định mức phải GIỮ NGUYÊN phần ADMIN thêm tay —
/// người ta thêm nó chính vì định mức không biết tới nó.
enum RequirementSource {
  NORM
  ADMIN_ADDED
}

/// Vật tư đội cứu hộ đang cầm nhưng chưa trả về kho.
enum RescueHoldingStatus {
  HELD
  RETURNED
}

enum MissionWarehouseRequestStatus {
  PENDING
  ACCEPTED
  PREPARED
  // Người đi lấy đã ký nhận. Tách khỏi PREPARED vì "kho đã soạn" và "hàng đã rời
  // kho" là hai việc khác nhau, và khoảng giữa hai việc đó là nơi hàng bị thiếu.
  PICKED_UP
}

// Nhiệm vụ cứu hộ — sinh từ tình huống, gồm nhu cầu + phương án phân bổ.
model Mission {
  id                    String                        @id @default(cuid())
  /// Số hiệu để người trực gọi tên nhiệm vụ với nhau ("nhiệm vụ số 12").
  ///
  /// `id` là cuid — đúng cho máy, nhưng không ai đọc qua điện thoại được. Số hiệu
  /// lấy từ sequence của Postgres nên KHÔNG BAO GIỜ cấp lại số đã dùng: xoá nhiệm
  /// vụ số 5 rồi tạo mới thì cái mới là số 6, không phải số 5. Đánh số lại theo vị
  /// trí trong danh sách sẽ khiến hai người nói "số 5" mà chỉ hai việc khác nhau.
  missionNo             Int                           @unique @default(autoincrement())
  warehouseId           String
  warehouse             Warehouse                     @relation("MissionSourceWarehouse", fields: [warehouseId], references: [id])
  incidentType          String
  location              String?
  affectedPeople        Int
  durationHours         Int
  priority              String
  parsedInput           Json // JSON tình huống đã parse (từ AI hoặc nhập tay)
  reportText            String? // mô tả thô của trưởng thôn (mobile) — web đọc lại để tự điền + phân tích
  status                MissionStatus                 @default(DRAFT)
  fulfillment           Float                         @default(0) // mức đáp ứng % (min qua các loại)
  readinessAssessment   Json? // blocker + trạng thái + mức đáp ứng tại lúc lập phương án
  explanation           String? // giải thích AI (tiếng Việt)
  rejectionReason       String? // lý do đội cứu hộ từ chối (thiếu nhân lực/vật tư/xin trì hoãn) — admin đọc sau
  adminNote             String? // ghi chú admin khi tạm hoãn/gửi lại/huỷ — đội cứu hộ đọc
  deliveryOutcome       DeliveryOutcome? // kết quả giao hiện trường (đội cứu hộ xác nhận khi hoàn tất)
  deliveryNote          String? // ghi chú kết quả giao (vd: thiếu 20 áo phao, đường tắc phải giao điểm khác)
  completedAt           DateTime? // thời điểm đội cứu hộ xác nhận đã giao
  /// Đã chạy bước chọn kho và tính khoảng cách chưa — CỔNG DUY NHẤT trả lời câu đó.
  ///
  /// Bản tham mưu bây giờ chỉ có số lượng: `requirements[].allocations` rỗng,
  /// `fulfillment` bằng 0 và `readinessAssessment` để trống cho tới khi ADMIN bấm
  /// lập kế hoạch. Ba dấu hiệu ấy đều CÓ THỂ dùng để đoán "đã tính kho chưa", và
  /// đó chính là vấn đề: ba nơi đoán theo ba kiểu rồi trôi lệch nhau. Ví dụ đã
  /// gặp trong thiết kế: khối tham mưu đọc `requirements.length > 0` nên kết luận
  /// "đã tính xong, kho đáp ứng 0%" cho một nhiệm vụ chưa hề chọn kho.
  allocationPlannedAt   DateTime?
  /// Hiện trường báo không cần lấy gì từ kho — bỏ hẳn chặng kho chuẩn bị.
  ///
  /// KHÔNG suy ra từ "không có phiếu vật tư nào": không có phiếu còn là kết quả
  /// của một cụm kho trống rỗng, mà ca đó phải bị chặn phát hành chứ không phải
  /// được đi tắt.
  warehouseStageSkipped Boolean                       @default(false)
  actionPlan            Json? // Incident Action Plan (8 mục, ActionPlanResponse từ AI)
  hamletId              String?
  hamlet                Hamlet?                       @relation(fields: [hamletId], references: [id], onDelete: SetNull)
  hamletName            String? // snapshot tên thôn lúc ADMIN lập phương án
  incidentLat           Float? // toạ độ điểm nạn (ghim tay) — tính khoảng cách kho gần nhất
  incidentLng           Float?
  createdByUserId       String?
  reportRequestId       String? // khóa retry do client gửi, chỉ có ý nghĩa trong scope người báo
  approvedByUserId      String?
  /// Người bấm "Duyệt và phát hành". Một xã có nhiều quản trị viên cùng duyệt để
  /// chia tải, nên phải truy được ai đã chốt phương án nào — người trực cần biết
  /// gọi ai khi phải hỏi lại. Trước đây chỉ lưu id trần, không tra ra được tên.
  approvedBy            User?                         @relation("MissionApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  createdAt             DateTime                      @default(now())
  approvedAt            DateTime?
  requirements          MissionRequirement[]
  warehousePreparations MissionWarehousePreparation[]
  warehouseRequests     MissionWarehouseRequest[]
  analysisSnapshots     MissionAnalysisSnapshot[]
  deliveryPhotos        MissionDeliveryPhoto[]
  reportAudio           MissionReportAudio?
  fieldUpdates          MissionFieldUpdate[]
  supplyHoldings        RescueSupplyHolding[]

  @@unique([createdByUserId, reportRequestId])
  @@index([hamletId])
}

/// Ảnh bằng chứng lực lượng hiện trường gửi kèm lúc báo hoàn thành nhiệm vụ.
///
/// Bytes nằm ở Supabase Storage, bảng này chỉ giữ khoá vật thể. Ảnh là thứ NẶNG
/// và KHÔNG BAO GIỜ được truy vấn theo nội dung, nên để trong Postgres là bắt mọi
/// bản pg_dump hằng ngày phải cõng lại toàn bộ tập ảnh — một nhiệm vụ vài tấm,
/// vài trăm nhiệm vụ là bản sao lưu phình lên hàng GB trong khi phần dữ liệu thật
/// sự cần khôi phục nhanh chỉ vài chục MB.
///
/// `data` là đường lui cho máy chưa cấu hình SUPABASE_URL (máy dev, máy chấm thi
/// chạy ngoại tuyến): thà nặng DB còn hơn mất tính năng vì thiếu một biến môi
/// trường. Mỗi hàng chỉ có ĐÚNG MỘT trong hai.
/// Bản ghi âm trưởng thôn gửi kèm báo cáo tình huống.
///
/// Vì sao BẢNG RIÊNG chứ không thêm cột vào `Mission`: hộp nhiệm vụ đọc mission
/// theo lô, không chọn cột. Một cột bytes nằm trên `Mission` là mỗi lượt mở hộp
/// thư kéo theo cả tập file ghi âm — kể cả lượt của người chỉ liếc trạng thái
/// trên điện thoại giữa vùng sóng yếu. Giống hệt lý do `MissionDeliveryPhoto`
/// đứng riêng.
///
/// MỘT báo cáo chỉ có MỘT bản ghi âm: đây là lời kể của người báo, không phải
/// tập bằng chứng. Muốn nói thêm thì gửi báo cáo mới.
model MissionReportAudio {
  id         String   @id @default(cuid())
  missionId  String   @unique
  mission    Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  data       Bytes
  /// Định dạng lấy từ máy khách nhưng đã lọc qua danh sách cho phép ở backend.
  mimeType   String
  byteSize   Int
  /// Độ dài tính bằng mili giây, để hiện "0:42" trước khi tải file về nghe.
  durationMs Int?
  createdAt  DateTime @default(now())
}

model MissionDeliveryPhoto {
  id               String   @id @default(cuid())
  missionId        String
  mission          Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  /// Khoá vật thể trên kho ảnh ngoài (Supabase Storage). Có giá trị này thì `data` rỗng.
  storageKey       String?
  /// Bytes lưu thẳng trong DB — chỉ dùng khi CHƯA cấu hình kho ảnh ngoài (máy dev).
  data             Bytes?
  /// Định dạng nhận diện từ byte đầu tệp lúc nhận, không lấy theo lời khai máy khách.
  mimeType         String
  byteSize         Int
  uploadedByUserId String?
  createdAt        DateTime @default(now())

  @@index([missionId])
}

/// Immutable evidence of a human-reviewed coordination analysis. It captures
/// its exact inputs, output, provenance and version stamps, without assigning
/// people, contacting another commune, or mutating inventory.
enum MissionAnalysisSnapshotKind {
  BASELINE
  WHAT_IF
}

model MissionAnalysisSnapshot {
  id                     String                      @id @default(cuid())
  missionId              String
  mission                Mission                     @relation(fields: [missionId], references: [id], onDelete: Cascade)
  kind                   MissionAnalysisSnapshotKind
  requestId              String?
  fingerprint            String
  baselineSnapshotId     String?
  baselineSnapshot       MissionAnalysisSnapshot?    @relation("MissionAnalysisBaseline", fields: [baselineSnapshotId], references: [id], onDelete: SetNull)
  derivedSnapshots       MissionAnalysisSnapshot[]   @relation("MissionAnalysisBaseline")
  input                  Json
  provenance             Json
  result                 Json
  assumptions            Json?
  modelVersion           String
  ruleVersion            String
  geoRegistryVersion     String?
  routingGraphVersion    String?
  weatherSnapshotVersion String?
  actorId                String
  actor                  User                        @relation("MissionAnalysisActor", fields: [actorId], references: [id])
  computedAt             DateTime                    @default(now())
  expiresAt              DateTime?

  @@unique([missionId, requestId])
  @@index([missionId, kind, computedAt])
  @@index([baselineSnapshotId])
}

enum FieldUpdateInputMode {
  TEXT
  VOICE_TRANSCRIPT
}

/// A confirmed, idempotent field observation. The stored text is deliberately
/// limited to the operator-confirmed transcript; media and continuous tracking
/// are outside the product scope.
model MissionFieldUpdate {
  id               String               @id @default(cuid())
  missionId        String
  mission          Mission              @relation(fields: [missionId], references: [id], onDelete: Cascade)
  actorId          String
  actor            User                 @relation("MissionFieldUpdateActor", fields: [actorId], references: [id])
  requestId        String
  inputMode        FieldUpdateInputMode
  confirmedText    String
  clientCapturedAt DateTime?
  structuredIntent Json?
  intentProvenance Json?
  createdAt        DateTime             @default(now())

  @@unique([missionId, actorId, requestId])
  @@index([missionId, createdAt])
  @@index([actorId, createdAt])
}

// Nhu cầu vật tư của nhiệm vụ (sinh từ định mức, ADMIN rà soát sửa được).
model MissionRequirement {
  id                 String            @id @default(cuid())
  missionId          String
  mission            Mission           @relation(fields: [missionId], references: [id], onDelete: Cascade)
  sku                String
  itemName           String
  required           Int // số cần theo định mức (hoặc số ADMIN sửa lại)
  allocated          Int // số cấp được từ kho (greedy) — 0 cho tới khi lập kế hoạch
  shortage           Int // thiếu = warehouseQuantity - allocated
  unit               String
  allocations        Json // chi tiết phân bổ theo lô [{batchId, qty, expiryDate}] — rỗng ở bản tham mưu
  neighborSuggestion Json? // gợi ý mượn kho lân cận nếu thiếu [{name, distanceKm, available}]
  source             RequirementSource @default(NORM)
  /// Hiện trường quyết gì với món này; NULL nghĩa là chưa trả lời.
  pickupDecision     PickupDecision?
  /// Số PHẢI LẤY TỪ KHO sau khi hiện trường chốt. Đây mới là con số đem đi phân bổ.
  ///
  /// Tách khỏi `required` vì hai số trả lời hai câu khác nhau: `required` là "chỗ
  /// này cần bao nhiêu", còn số này là "kho phải xuất bao nhiêu". Đội đang giữ sẵn
  /// 20 áo phao thì hai số lệch nhau đúng 20, và mọi phép đánh giá đáp ứng phải
  /// đọc số thứ hai — đọc `required` là mọi nhiệm vụ lấy một phần đều hiện "thiếu"
  /// vĩnh viễn dù kho đã xuất đủ phần được yêu cầu.
  warehouseQuantity  Int               @default(0)
  /// Số bù bằng vật tư đội đang tạm giữ từ nhiệm vụ trước.
  heldQuantity       Int               @default(0)
  /// Dòng tạm giữ sẽ được chuyển sang nhiệm vụ này — mới là Ý ĐỊNH, chưa chuyển.
  ///
  /// Việc chuyển thật nằm trong transaction phát hành. Chuyển ngay lúc hiện trường
  /// trả lời thì ADMIN huỷ nhiệm vụ là phần đang giữ mắc kẹt ở một nhiệm vụ đã
  /// huỷ, trong khi nhiệm vụ cũ đã kịp ghi "đã hoàn vật tư".
  heldFromHoldingId  String?
  decidedAt          DateTime?
  decidedByUserId    String?
  decidedBy          User?             @relation("MissionRequirementDecidedBy", fields: [decidedByUserId], references: [id], onDelete: SetNull)

  // ADMIN thêm được món tay thì phải chặn hai dòng cùng SKU: phiếu kho gộp theo
  // (kho, SKU) nên vẫn chạy, nhưng bảng đánh giá đếm món đó hai lần và sinh hai
  // dòng blocker giống hệt nhau.
  @@unique([missionId, sku])
  @@index([missionId])
}

/// Vật tư đội cứu hộ ĐANG CẦM: đã hoàn thành nhiệm vụ nhưng chưa trả về kho.
///
/// Vì sao cần bảng này: hàng đã được `bulkExportInTx` trừ khỏi `ItemBatch.quantity`
/// ngay lúc kho xuất, nên từ đó trở đi không sổ nào nói nó đang ở đâu. Nhiệm vụ
/// đóng lại là dấu vết cuối cùng biến mất — tồn kho ghi "đã xuất", còn hai chục
/// áo phao thì nằm trên xe đội cứu hộ cho tới đợt kiểm kê sau mới lòi ra.
///
/// CHỈ vật tư tái sử dụng (`Item.consumable = false`) vào đây. Nước uống và lương
/// khô phát cho dân rồi thì không có gì để đòi trả, ghi vào sổ là treo vĩnh viễn
/// một khoản không bao giờ tất toán được.
///
/// KHÔNG dùng lại `LoanRecord` cho việc này. Phiếu mượn là GIỮ CHỖ TẠI CHỖ —
/// `loan.service.ts` ghi rõ "KHÔNG trừ tổng kho", và `loadClusterBatches` cùng
/// `detectCommitmentShortfalls` đều TRỪ phần đang mượn ra khỏi `quantity`. Tạo
/// phiếu mượn cho số hàng đã rời kho là trừ hai lần cùng một đống hàng.
///
/// Sổ theo TỔ CHỨC (xã), không theo người: mỗi xã một đội cứu hộ, và người ký
/// nhận hôm nay với người mang trả hôm sau thường không phải một.
model RescueSupplyHolding {
  id                       String              @id @default(cuid())
  organizationId           String
  organization             Organization        @relation(fields: [organizationId], references: [id])
  /// Nhiệm vụ đang chịu trách nhiệm cho phần đang giữ này.
  ///
  /// Đổi khi phần đang giữ được dùng cho nhiệm vụ sau: dòng cũ giảm đi, dòng mới
  /// mọc ra ở nhiệm vụ mới. Nhờ vậy chỉ phải trả MỘT lần ở cuối chuỗi.
  missionId                String
  mission                  Mission             @relation(fields: [missionId], references: [id], onDelete: Cascade)
  /// Kho phải nhận lại. Thiếu nó thì bất kỳ thủ kho nào trong xã cũng xác nhận
  /// được phần hàng của kho khác, và `bulkImportInTx` gọi `incrementInTx` KHÔNG
  /// kèm phạm vi kho nên chốt chặn sẵn có ở đó không bao giờ chạy.
  warehouseId              String
  warehouse                Warehouse           @relation(fields: [warehouseId], references: [id])
  sku                      String
  itemName                 String
  unit                     String
  quantity                 Int
  /// Lô gốc để hoàn đúng chỗ: [{batchId, qty, warehouseId, ...}].
  ///
  /// Chụp lại lúc đóng nhiệm vụ chứ không tính lại lúc trả: phiếu vật tư có thể
  /// đã bị điều phối cắt bớt, và phần đang giữ có thể đã đi qua vài nhiệm vụ.
  batches                  Json
  status                   RescueHoldingStatus @default(HELD)
  heldSince                DateTime            @default(now())
  returnedAt               DateTime?
  confirmedByUserId        String?
  confirmedBy              User?               @relation("RescueSupplyHoldingConfirmedBy", fields: [confirmedByUserId], references: [id], onDelete: SetNull)
  /// Dòng tạm giữ đã sinh ra dòng này — theo dấu được cả chuỗi A→B→C và cả lần
  /// tách đôi, thứ mà chỉ ghi `missionId` nguồn thì không dựng lại được.
  transferredFromHoldingId String?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  @@index([organizationId, sku, status])
  @@index([organizationId, status])
  @@index([missionId])
}

// Tiến độ chuẩn bị/xuất kho của từng kho tham gia một nhiệm vụ đa kho.
// Một kho chỉ có thể claim một dòng duy nhất; preparedAt là dấu idempotency chống xuất trùng.
model MissionWarehousePreparation {
  id               String    @id @default(cuid())
  missionId        String
  mission          Mission   @relation(fields: [missionId], references: [id], onDelete: Cascade)
  warehouseId      String
  warehouse        Warehouse @relation(fields: [warehouseId], references: [id])
  preparedByUserId String?
  preparedBy       User?     @relation(fields: [preparedByUserId], references: [id], onDelete: SetNull)
  preparedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([missionId, warehouseId])
  @@index([warehouseId, preparedAt])
}

// Từng SKU mà một kho tham gia phải tiếp nhận và chuẩn bị cho nhiệm vụ.
// preparationClaimToken là CAS lock: ADMIN không thể sửa khi kho đang xuất.
model MissionWarehouseRequest {
  id                    String                        @id @default(cuid())
  missionId             String
  mission               Mission                       @relation(fields: [missionId], references: [id], onDelete: Cascade)
  warehouseId           String
  warehouse             Warehouse                     @relation(fields: [warehouseId], references: [id])
  sku                   String
  itemName              String
  unit                  String
  requestedQuantity     Int
  preparedQuantity      Int                           @default(0)
  allocations           Json
  preparedAllocations   Json?
  status                MissionWarehouseRequestStatus @default(PENDING)
  warehouseNote         String?
  adminNote             String?
  acceptedByUserId      String?
  acceptedBy            User?                         @relation("MissionWarehouseRequestAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  preparedByUserId      String?
  preparedBy            User?                         @relation("MissionWarehouseRequestPreparedBy", fields: [preparedByUserId], references: [id], onDelete: SetNull)
  preparationClaimToken String?
  preparationClaimedAt  DateTime?
  acceptedAt            DateTime?
  preparedAt            DateTime?
  // Xác nhận LẤY hàng. Để rỗng nghĩa là chưa ai ký nhận, khác hẳn với nhận đủ 0.
  pickedUpQuantity      Int?
  pickupNote            String?
  pickedUpByUserId      String?
  pickedUpBy            User?                         @relation("MissionWarehouseRequestPickedUpBy", fields: [pickedUpByUserId], references: [id], onDelete: SetNull)
  pickedUpAt            DateTime?
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt

  @@unique([missionId, warehouseId, sku])
  @@index([warehouseId, status, createdAt])
  @@index([missionId, status])
  @@index([preparationClaimToken])
}

// ===== Phase E: Incident Intelligence =====

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentState {
  OPEN // mới phát hiện
  ACKNOWLEDGED // đã tiếp nhận
  ASSIGNED // đã phân công
  RESOLVED // đã xử lý
}

// Sự cố do rule engine phát hiện từ hợp nhất sự kiện cảm biến.
model Incident {
  id                 String             @id @default(cuid())
  warehouseId        String
  sourceSubmissionId String?
  sourceSubmission   SensorSubmission?  @relation(fields: [sourceSubmissionId], references: [id], onDelete: SetNull)
  zoneId             String?
  kind               String // SUSPECTED_LOSS | SENSOR_FAULT | BAD_STORAGE | MISPLACED...
  severity           IncidentSeverity
  confidence         Float // 0..1 độ tin cậy kết luận
  title              String
  explanation        String? // LLM diễn đạt (tiếng Việt) — không tự kết luận số
  state              IncidentState      @default(OPEN)
  detectedAt         DateTime           @default(now())
  resolvedAt         DateTime?
  evidence           IncidentEvidence[]
  actions            IncidentAction[]
  emailOutbox        AlertEmailOutbox?

  @@index([warehouseId, state])
  @@index([sourceSubmissionId])
}

// Bằng chứng: từng sự kiện cảm biến góp phần vào kết luận (timeline).
model IncidentEvidence {
  id         String   @id @default(cuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  deviceCode String
  eventType  String
  value      Float
  weight     Float // trọng số đóng góp vào điểm nghiêm trọng
  occurredAt DateTime
  note       String?

  @@index([incidentId, occurredAt])
}

// Hành động xử lý sự cố (acknowledge/assign/resolve).
model IncidentAction {
  id             String   @id @default(cuid())
  incidentId     String
  incident       Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  action         String
  idempotencyKey String?
  actorId        String?
  note           String?
  createdAt      DateTime @default(now())

  @@unique([incidentId, idempotencyKey])
  @@index([incidentId])
}

enum AlertEmailStatus {
  PENDING
  SENDING
  SENT
}

// Outbox bền vững: trạng thái chuyển phát email, không quyết định trạng thái sự cố.
// Email gửi muộn luôn lấy observedAt/receivedAt ở đây để phân biệt với sentAt.
model AlertEmailOutbox {
  id              String           @id @default(cuid())
  incidentId      String           @unique
  incident        Incident         @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  warehouseId     String
  warehouse       Warehouse        @relation(fields: [warehouseId], references: [id])
  recipientEmails String[]         @default([])
  observedAt      DateTime
  receivedAt      DateTime
  status          AlertEmailStatus @default(PENDING)
  attempts        Int              @default(0)
  lastAttemptAt   DateTime?
  nextAttemptAt   DateTime         @default(now())
  lastError       String?
  sentAt          DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([status, nextAttemptAt])
  @@index([warehouseId, createdAt])
}

// Đếm số call API ngoài (Google Maps) theo tháng — chặn quota, không bị trừ tiền.
model ApiUsage {
  id        String   @id @default(cuid())
  provider  String // vd "google-routes"
  yearMonth String // "2026-07"
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([provider, yearMonth])
}

// Thông báo liên role (workflow cứu hộ) — đẩy realtime qua WebSocket theo role.
enum NotificationKind {
  MISSION_ASSIGNED // ADMIN sinh plan → báo cứu hộ
  RESCUE_CONFIRMED // cứu hộ xác nhận → báo kho
  WAREHOUSE_READY // kho chuẩn bị xong → báo admin + cứu hộ
  INTER_WAREHOUSE_REQUEST // thiếu → báo kho lân cận
  INCIDENT_DETECTED // sensor phát hiện sự cố → báo admin
  READINESS_DEGRADED // readiness rớt DEGRADED/CRITICAL → báo kho
  MISSION_REJECTED // đội cứu hộ từ chối nhiệm vụ (kèm lý do) → báo admin
  MISSION_DEFERRED // admin tiếp nhận đơn → tạm hoãn, báo đội cứu hộ
  MISSION_CANCELLED // admin huỷ nhiệm vụ (kèm lý do) → báo đội cứu hộ
  MISSION_COMPLETED // đội cứu hộ xác nhận đã giao (kèm kết quả) → báo admin + kho
  INCIDENT_REPORTED // trưởng thôn báo cáo tình huống từ hiện trường → báo admin
  FIELD_UPDATE_REPORTED // lực lượng hiện trường gửi evidence đã tự xác nhận → báo admin
  WAREHOUSE_REQUESTED // admin phát hành/cập nhật yêu cầu SKU → báo kho
  WAREHOUSE_REQUEST_ACCEPTED // kho xác nhận tiếp nhận một SKU → báo admin
  WAREHOUSE_REQUEST_REVIEW // kho báo thiếu/sai, cần admin xem lại
}

model Notification {
  id             String           @id @default(cuid())
  // Nullable only while legacy records are backfilled. Runtime reads never
  // expose a null-scoped record, so old data cannot leak across organizations.
  organizationId String?
  organization   Organization?    @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  recipientRole  UserRole // gửi theo role (WAREHOUSE/RESCUE/ADMIN)
  missionId      String?
  /// Số hiệu nhiệm vụ, chép lại tại thời điểm gửi.
  ///
  /// Người trực gọi nhau bằng "nhiệm vụ số 127", không ai đọc cuid qua điện thoại.
  /// Thẻ thông báo phải nói được số đó thì người nhận mới biết tin này thuộc việc
  /// nào trong mấy việc đang chạy cùng lúc.
  ///
  /// Chép lại chứ không đọc ngược sang Mission lúc hiện thẻ: mỗi thẻ sẽ là một
  /// lượt gọi mạng, và thông báo của nhiệm vụ đã xoá sẽ mất luôn danh tính. Cùng
  /// lý do với `incidentType` / `affectedPeople` ngay dưới đây.
  missionNo      Int?
  warehouseId    String?
  kind           NotificationKind
  title          String
  body           String
  read           Boolean          @default(false)
  // Deep-link target for ADMIN evidence review. It is a scalar by design so
  // notification retention never owns or deletes the immutable evidence.
  // Khoản mượn liên xã mà thông báo này nói tới.
  //
  // Có nó thì thông báo MANG THEO HÀNH ĐỘNG: màn hình dựng được hai nút Đồng ý /
  // Từ chối ngay trên thẻ thông báo, người trực không phải mở tab Mượn trả rồi
  // tìm lại đúng dòng. Lúc đang bão, mỗi bước phải đi tìm là một bước bị bỏ.
  loanId         String?
  fieldUpdateId  String?          @unique
  // Tình huống mà thông báo nói tới, chép lại tại thời điểm gửi.
  //
  // Thẻ thông báo phải nhận ra ĐƯỢC NGAY là bão hay sạt lở, bao nhiêu người, ở
  // thôn nào — để chọn biểu tượng và in đậm đúng phần người trực cần thấy trước.
  // Đọc ngược sang Mission lúc hiện thẻ thì mỗi thẻ là một lượt gọi mạng, và
  // nhiệm vụ sửa số về sau sẽ làm thông báo cũ kể lại một câu chuyện khác với
  // lúc nó được gửi.
  incidentType   String?
  affectedPeople Int?
  locationName   String?
  createdAt      DateTime         @default(now())

  @@index([organizationId, recipientRole, read])
}

/// Chiều của một khoản mượn liên xã, xét TỪ PHÍA xã đang giữ bản ghi.
enum InterCommuneLoanDirection {
  OUTGOING // xã mình CHO xã khác mượn
  INCOMING // xã mình ĐI mượn của xã khác
}

enum InterCommuneLoanStatus {
  REQUESTED // đã gửi yêu cầu, chờ bên kia quyết
  REJECTED // bên cho mượn từ chối
  APPROVED // bên cho mượn đồng ý và đã trừ kho
  ACTIVE // bên mượn đã xác nhận nhận hàng — đang nợ
  PARTIALLY_RETURNED // đã trả một phần, còn nợ phần còn lại
  RETURNED // đã trả xong
  CANCELLED // bên yêu cầu tự huỷ trước khi có quyết định
}

/// Khoản mượn vật tư giữa hai xã.
///
/// Mỗi xã chạy một cơ sở dữ liệu RIÊNG, nên một khoản mượn tồn tại thành HAI bản
/// ghi — một ở mỗi xã, `direction` ngược nhau. Không có bản ghi dùng chung, vì
/// không có cơ sở dữ liệu dùng chung.
///
/// `peerLoanId` nối hai bản ghi đó lại khi tin đi được qua mạng. Mất mạng thì
/// trường này để trống và mỗi bên tự ghi tay theo thoả thuận qua điện thoại —
/// đúng cách hai xã vẫn làm với nhau từ trước tới nay, chỉ khác là nay có sổ.
///
/// Ghi theo SKU và số lượng chứ không trỏ tới lô cụ thể: lô là chuyện nội bộ của
/// mỗi kho, xã bên kia không biết và cũng không cần biết mã lô của xã này.
model InterCommuneLoan {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  direction InterCommuneLoanDirection
  status    InterCommuneLoanStatus    @default(REQUESTED)

  /// Tên xã bên kia, lưu nguyên văn: danh mục xã lân cận có thể đổi, nhưng sổ nợ
  /// thì phải đọc được y như lúc ghi.
  peerCommuneName String
  /// Id bản ghi tương ứng bên xã kia. Trống khi hai bên ghi tay lúc mất mạng.
  ///
  /// DUY NHẤT: hai bản ghi cùng trỏ về một khoản bên kia nghĩa là đã nhân đôi
  /// khoản nợ. Ràng buộc ở tầng CSDL vì đây là thứ phải đúng kể cả khi tin tới
  /// hai lần do gửi lại.
  peerLoanId      String? @unique

  /// Khoá chống nhận trùng cho yêu cầu tới từ xã kia.
  ///
  /// Đường truyền giữa hai xã là thứ hay đứt nhất trong cả hệ thống, nên xã gửi
  /// sẽ gửi lại. Không có khoá này thì mỗi lần gửi lại là một khoản mượn mới, và
  /// kho bên cho mượn bị trừ nhiều lần cho cùng một yêu cầu. Dự án đã dùng đúng
  /// cách này cho lô số liệu cảm biến và cho thao tác kho.
  inboundKey String? @unique

  itemSku          String
  itemName         String
  /// Số lượng mượn theo thoả thuận.
  quantity         Int
  /// Đã trả được bao nhiêu (cộng dồn).
  ///
  /// Trả TỪNG PHẦN là chuyện bình thường: mượn 200 chai, trả 180, hỏng mất 20.
  /// Mô hình mượn trong xã của chính dự án này đã có returnedOk/returnedDamaged/
  /// lost từ đầu; ghi nhận liên xã kiểu được-ăn-cả-ngã-về-không thì hoặc phải
  /// khai khống là đã trả đủ, hoặc để khoản nợ mở mãi mãi.
  returnedQuantity Int    @default(0)
  unit             String

  /// Kho của xã mình chịu trách nhiệm cho khoản này (xuất ra hoặc nhận về).
  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])

  /// true khi bản ghi do người nhập tay vì lúc đó không gửi được qua mạng.
  recordedManually Boolean @default(false)
  // Việc chuyển kho ĐÃ HỨA nhưng chưa chắc đã xong.
  //
  // Sổ và kho nằm ở hai transaction khác nhau (inventory.export/import tự mở
  // transaction riêng), nên có một khe hẹp giữa lúc chốt sổ và lúc hàng thật sự
  // rời kho. Sập nguồn đúng khe đó thì sổ ghi đã chuyển mà hàng còn nguyên, và
  // không ai biết cho tới kỳ đối chiếu.
  //
  // Ghi lại đủ tham số để CHẠY LẠI. An toàn vì requestId bên trong là khoá chống
  // trùng của kho: chuyển rồi thì lần chạy lại không chuyển thêm lần nữa.
  pendingStockMove Json?

  note         String?
  rejectReason String?

  requestedAt DateTime  @default(now())
  decidedAt   DateTime?
  receivedAt  DateTime?
  returnedAt  DateTime?

  createdByUserId String?

  @@index([organizationId, direction, status])
  @@index([peerLoanId])
}
