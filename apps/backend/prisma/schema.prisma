// Ứng phó nhanh — schema cốt lõi (Nền móng #0).
// Bảng Readiness / Mission / Simulator / Incident thêm ở lát tương ứng.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// WAREHOUSE kiêm luôn vai trưởng thôn: cùng một người giữ kho và báo tình huống
// của thôn mình, nên không tách thành hai tài khoản.
enum UserRole {
  WAREHOUSE
  RESCUE
  ADMIN
}

enum ItemStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
  DAMAGED
  EXPIRING_SOON
  INSPECTION_OVERDUE
  MISPLACED
  UNKNOWN
  INACCESSIBLE
}

enum TransactionType {
  IMPORT
  EXPORT
  TRANSFER
  RETURN
  ADJUST
  COUNT
  CONDITION
  LOAN_OUT_INTERXA // cho xã khác mượn
  LOAN_IN // mượn từ xã khác
}

// Nguồn giao dịch — độ lệch giữa nguồn feed vào "độ tin cậy" Readiness
enum TransactionSource {
  SCAN
  BULK
  LOADCELL
  RFID
  MANUAL
}

// Trạng thái vật tư 2 CHIỀU độc lập (C-minus)
enum ItemCondition {
  NEW // mới
  USED // cũ, đã dùng
  NEEDS_CHECK // cần kiểm tra
  DAMAGED // hư hỏng
}

enum CirculationStatus {
  IN_STOCK // trong kho
  ON_LOAN // đang mượn — vẫn thuộc kho, KHÔNG tính mất
  RETURNED // vừa hoàn, chờ kiểm tra
}

enum LoanStatus {
  ON_LOAN
  PARTIALLY_RETURNED
  CLOSED
}

model Organization {
  id            String         @id @default(cuid())
  name          String
  createdAt     DateTime       @default(now())
  users         User[]
  warehouses    Warehouse[]
  hamlets       Hamlet[]
  notifications Notification[]
  interCommuneLoans InterCommuneLoan[]
}

model User {
  id                      String                        @id @default(cuid())
  organizationId          String
  organization            Organization                  @relation(fields: [organizationId], references: [id])
  email                   String                        @unique
  passwordHash            String
  fullName                String
  phone                   String?
  notificationEmail       String?
  avatarUrl               String?
  role                    UserRole                      @default(WAREHOUSE)
  // Tăng khi đăng nhập, refresh hoặc logout để thu hồi toàn bộ JWT cũ của tài khoản.
  tokenVersion            Int                           @default(0)
  // Scope kho: null = phụ trách toàn xã (kho tổng); có giá trị = trưởng thôn CHỈ quản kho này.
  warehouseId             String?
  warehouse               Warehouse?                    @relation(fields: [warehouseId], references: [id])
  createdAt               DateTime                      @default(now())
  transactions            InventoryTransaction[]
  reports                 MonthlyStockReport[]
  missionPreparations     MissionWarehousePreparation[]
  missionRequestsAccepted MissionWarehouseRequest[]     @relation("MissionWarehouseRequestAcceptedBy")
  missionRequestsPrepared MissionWarehouseRequest[]     @relation("MissionWarehouseRequestPreparedBy")
  missionRequestsPickedUp MissionWarehouseRequest[]     @relation("MissionWarehouseRequestPickedUpBy")
  analysisSnapshots       MissionAnalysisSnapshot[]     @relation("MissionAnalysisActor")
  fieldUpdates            MissionFieldUpdate[]          @relation("MissionFieldUpdateActor")
  sensorSubmissions       SensorSubmission[]
}

enum WarehouseKind {
  CENTRAL // kho tổng — trung tâm hành chính xã
  HAMLET // kho thôn — mỗi thôn 1 kho nhỏ
}

model Warehouse {
  id                  String                        @id @default(cuid())
  organizationId      String
  organization        Organization                  @relation(fields: [organizationId], references: [id])
  name                String
  location            String?
  kind                WarehouseKind                 @default(HAMLET) // kho tổng hay kho thôn
  communeId           String                        @default("default-commune") // nhóm kho cùng xã — AI query cả cụm
  lat                 Float? // toạ độ ghim tay (không geocode)
  lng                 Float?
  distanceKm          Float                         @default(0) // fallback thủ công khi chưa có lat/lng
  createdAt           DateTime                      @default(now())
  zones               WarehouseZone[]
  leaders             User[] // trưởng thôn scope kho này
  reports             MonthlyStockReport[]
  missions            Mission[]                     @relation("MissionSourceWarehouse")
  missionPreparations MissionWarehousePreparation[]
  missionRequests     MissionWarehouseRequest[]
  sensorSubmissions   SensorSubmission[]
  deviceCredentials   DeviceCredential[]
  alertEmailOutboxes  AlertEmailOutbox[]
  interCommuneLoans   InterCommuneLoan[]
}

// Thôn/điểm ứng phó do ADMIN cấu hình trước. Marker này độc lập với marker kho.
// Tên chuẩn hóa/alias chỉ dùng để resolve địa danh deterministic trong đúng org+xã.
model Hamlet {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  communeId      String       @default("default-commune")
  name           String
  normalizedName String
  aliases        String[]     @default([])
  lat            Float?
  lng            Float?
  verified       Boolean      @default(false)
  verifiedAt     DateTime?
  verifiedById   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  missions       Mission[]

  @@unique([organizationId, communeId, normalizedName])
  @@index([organizationId, communeId])
}

enum ReportStatus {
  PENDING // trưởng thôn gửi, chờ admin xã duyệt
  APPROVED // admin duyệt → đã áp reconcile vào tồn
  REJECTED // admin từ chối
}

// Báo cáo kiểm kê tháng của kho thôn (BE Phase-thôn Luồng 2): trưởng thôn upload Excel
// → PENDING → admin xã duyệt → áp reconcile từng dòng. rows = snapshot Excel đã parse.
model MonthlyStockReport {
  id                String       @id @default(cuid())
  warehouseId       String
  warehouse         Warehouse    @relation(fields: [warehouseId], references: [id])
  submittedByUserId String
  submittedBy       User         @relation(fields: [submittedByUserId], references: [id])
  period            String // "YYYY-MM"
  status            ReportStatus @default(PENDING)
  rows              Json // [{sku, itemName, quantity, unit, expiryDate?, condition?, note?}]
  note              String?
  approvedByUserId  String?
  approvedAt        DateTime?
  createdAt         DateTime     @default(now())

  @@index([warehouseId, period])
}

// Kho lân cận (xã khác) — NHẬP TAY, AI đọc để gợi ý mượn liên xã. KHÔNG sync DB thật (#30)
model NeighborWarehouse {
  id          String   @id @default(cuid())
  warehouseId String // kho của mình (tham chiếu)
  name        String // tên xã lân cận
  distanceKm  Float
  contactInfo String? // sđt/bộ đàm liên hệ
  summary     Json // tồn kho tóm tắt nhập tay: [{sku, name, quantity}]
  updatedAt   DateTime @updatedAt

  @@index([warehouseId])
}

model WarehouseZone {
  id          String    @id @default(cuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  code        String // ví dụ "A", "B"
  name        String
  shelves     Shelf[]

  @@unique([warehouseId, code])
}

model Shelf {
  id       String          @id @default(cuid())
  zoneId   String
  zone     WarehouseZone   @relation(fields: [zoneId], references: [id])
  code     String // ví dụ "A1", "A2"
  isLocked Boolean         @default(false) // bị khóa / thiếu quyền
  batches  ItemBatch[]
  devices  VirtualDevice[]

  @@unique([zoneId, code])
}

model ItemCategory {
  id    String @id @default(cuid())
  name  String @unique
  unit  String // đơn vị: chiếc, bộ, lít...
  items Item[]
}

model Item {
  id           String       @id @default(cuid())
  categoryId   String
  category     ItemCategory @relation(fields: [categoryId], references: [id])
  name         String
  sku          String       @unique
  consumable   Boolean      @default(false) // true=tiêu hao (nước/pin, xuất=mất); false=tái sử dụng (áo phao, xuất=mượn)
  unitWeightKg Float? // khối lượng đơn vị — loadcell suy số lượng (Bp1)
  createdAt    DateTime     @default(now())
  batches      ItemBatch[]
}

model ItemBatch {
  id           String                 @id @default(cuid())
  itemId       String
  item         Item                   @relation(fields: [itemId], references: [id])
  shelfId      String?
  shelf        Shelf?                 @relation(fields: [shelfId], references: [id])
  batchCode    String
  quantity     Int                    @default(0)
  status       ItemStatus             @default(AVAILABLE) // giữ tương thích; sẽ dùng condition+circulation
  condition    ItemCondition          @default(NEW) // chiều 1: tình trạng vật lý
  circulation  CirculationStatus      @default(IN_STOCK) // chiều 2: lưu hành
  expiryDate   DateTime?
  inspectedAt  DateTime?
  createdAt    DateTime               @default(now())
  transactions InventoryTransaction[]
  counts       InventoryCount[]
  loans        LoanRecord[]

  @@unique([itemId, batchCode])
}

// Phiếu mượn (#17) — vật tư consumable=false. Giữ ItemBatch nguyên, phân mảnh nằm ở phiếu.
model LoanRecord {
  id               String     @id @default(cuid())
  batchId          String
  batch            ItemBatch  @relation(fields: [batchId], references: [id])
  quantity         Int // số mượn
  borrowedByUserId String?
  missionId        String?
  status           LoanStatus @default(ON_LOAN)
  returnedOk       Int        @default(0) // hoàn tốt → USED về kho
  returnedDamaged  Int        @default(0) // hoàn hỏng → DAMAGED
  lost             Int        @default(0) // mất → trừ tổng kho
  borrowedAt       DateTime   @default(now())
  closedAt         DateTime?

  @@index([batchId, status])
}

// Kiểm kê thực tế — so với quantity hệ thống cho Readiness (khả dụng SL + độ tin cậy)
model InventoryCount {
  id         String    @id @default(cuid())
  batchId    String
  batch      ItemBatch @relation(fields: [batchId], references: [id])
  countedQty Int
  userId     String?
  note       String?
  countedAt  DateTime  @default(now())

  @@index([batchId, countedAt])
}

model InventoryTransaction {
  id              String            @id @default(cuid())
  batchId         String
  batch           ItemBatch         @relation(fields: [batchId], references: [id])
  userId          String
  user            User              @relation(fields: [userId], references: [id])
  type            TransactionType
  source          TransactionSource @default(SCAN) // nguồn — feed dataReliability
  quantity        Int
  // Additive ledger semantics: legacy `quantity` remains the business event
  // amount; these fields make stock reconstruction unambiguous.
  beforeQuantity  Int?
  afterQuantity   Int?
  quantityDelta   Int?
  note            String?
  // Warehouse snapshots preserve ledger ownership after a batch moves.
  warehouseId     String?
  fromWarehouseId String?
  toWarehouseId   String?
  createdAt       DateTime          @default(now())

  @@index([warehouseId, createdAt])
  @@index([fromWarehouseId, createdAt])
  @@index([toWarehouseId, createdAt])
}

// Audit log — mọi thao tác quan trọng ghi lại bất biến (PRD NFR-03)
model AuditLog {
  id             String   @id @default(cuid())
  actorId        String?
  organizationId String?
  warehouseId    String?
  correlationId  String?
  action         String
  entity         String
  entityId       String?
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([warehouseId, createdAt])
  @@index([correlationId])
}

// ===== Phase B: Sensor Simulator (mô phỏng lớp cảm biến) =====

enum VirtualDeviceType {
  LOADCELL
  TEMPERATURE
  HUMIDITY
  SMOKE
  DOOR
  RFID_GATEWAY
  CAMERA_AI
  POWER
  GATEWAY
}

// Nguồn sinh ra số liệu. KHÔNG rẽ nhánh xử lý theo trường này: nó chỉ phục vụ
// hiển thị và truy vết. Cảm biến thật và thiết bị mô phỏng đi chung một đường ống.
enum TelemetrySource {
  OPERATOR // người vận hành xác nhận giá trị trên desktop
  HARDWARE // gateway/cảm biến tự gửi
}

// Khoá của một gateway phần cứng. Thiết bị không có tài khoản người dùng; nó
// xác thực bằng khoá riêng, bị thu hồi độc lập, và chỉ gửi được cho đúng kho.
model DeviceCredential {
  id          String             @id @default(cuid())
  warehouseId String
  warehouse   Warehouse          @relation(fields: [warehouseId], references: [id])
  code        String // vd "gateway_kho_trung_tam"
  name        String
  tokenPrefix String             @unique // phần công khai, dùng để tra cứu
  tokenHash   String // bcrypt của phần bí mật — không lưu token gốc
  createdAt   DateTime           @default(now())
  lastSeenAt  DateTime?
  revokedAt   DateTime?
  submissions SensorSubmission[]

  @@unique([warehouseId, code])
}

model VirtualDevice {
  id                      String            @id @default(cuid())
  warehouseId             String
  zoneId                  String?
  shelfId                 String?
  shelf                   Shelf?            @relation(fields: [shelfId], references: [id])
  type                    VirtualDeviceType
  code                    String // vd "scale_shelf_A1"
  unit                    String // kg, °C, %, bool...
  online                  Boolean           @default(true)
  // Mốc số liệu gần nhất thực sự nhận được. Im lặng quá lâu là một sự cố, không
  // phải trạng thái bình thường — xem quy tắc DEVICE_SILENT.
  lastSeenAt              DateTime?
  // Chu kỳ báo mong đợi (giây). null = không giám sát im lặng cho thiết bị này.
  expectedIntervalSeconds Int?
  updatedAt               DateTime          @updatedAt
  events                  SensorEvent[]

  @@unique([warehouseId, code])
  @@index([warehouseId, type])
}

// Một lô số liệu đã được xác nhận: người vận hành bấm gửi, hoặc gateway phần cứng
// đẩy lên. Đây là boundary chống gửi trùng và giữ mốc thời gian thật của phép đo,
// không phải bảng giữ trạng thái IoT hiện hành.
model SensorSubmission {
  id                  String            @id @default(cuid())
  idempotencyKey      String            @unique
  payloadHash         String
  warehouseId         String
  warehouse           Warehouse         @relation(fields: [warehouseId], references: [id])
  source              TelemetrySource   @default(OPERATOR)
  // Đúng một trong hai được đặt: người xác nhận, hoặc thiết bị đã xác thực.
  submittedByUserId   String?
  submittedBy         User?             @relation(fields: [submittedByUserId], references: [id])
  submittedByDeviceId String?
  submittedByDevice   DeviceCredential? @relation(fields: [submittedByDeviceId], references: [id])
  observedAt          DateTime
  receivedAt          DateTime          @default(now())
  policyVersion       String
  events              SensorEvent[]
  incidents           Incident[]

  @@index([warehouseId, observedAt])
  @@index([submittedByUserId, receivedAt])
  @@index([submittedByDeviceId, receivedAt])
}

model SensorEvent {
  id           String            @id @default(cuid())
  submissionId String?
  submission   SensorSubmission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  deviceId     String
  device       VirtualDevice     @relation(fields: [deviceId], references: [id])
  warehouseId  String
  zoneId       String?
  eventType    String // WEIGHT_CHANGED, DOOR_OPEN, VISION_DETECTION...
  value        Float
  unit         String
  quality      Float             @default(1.0) // 0..1
  // Mốc operator xác nhận; createdAt là thời điểm backend ghi nhận event.
  observedAt   DateTime          @default(now())
  createdAt    DateTime          @default(now())

  @@unique([submissionId, deviceId])
  @@index([warehouseId, createdAt])
  @@index([warehouseId, observedAt])
}

// ===== Phase C: Readiness Score =====

// Cấu hình trọng số + ngưỡng công thức, chỉnh được theo từng kho (configurable).
// Rỗng → dùng READINESS_CONFIG mặc định (có disclaimer "tham khảo nghiên cứu").
model ReadinessRule {
  id          String   @id @default(cuid())
  warehouseId String   @unique
  weights     Json // { quantityAvailability, itemCondition, ... } tổng = 1
  thresholds  Json // { expiry, environment, dataReliability... }
  updatedAt   DateTime @updatedAt
}

// Ngưỡng hành động 4 vùng (C3) — chỉnh được mỗi kho.
model ReadinessThreshold {
  id          String   @id @default(cuid())
  warehouseId String   @unique
  ready       Int      @default(80) // >= ready: 🟢
  attention   Int      @default(70) // >= attention: 🟡
  degraded    Int      @default(50) // >= degraded: 🟠; dưới: 🔴
  updatedAt   DateTime @updatedAt
}

// ===== Phase D: Mission-to-Kit =====

enum MissionStatus {
  DRAFT // vừa lập phương án (ADMIN), chờ đẩy workflow
  PENDING_RESCUE // đã gửi, chờ cứu hộ xác nhận lấy
  RESCUE_CONFIRMED // cứu hộ đã xác nhận
  PENDING_WAREHOUSE // chờ kho chuẩn bị + xuất
  READY // kho đã chuẩn bị xong, sẵn sàng giao
  APPROVED // (cũ, giữ tương thích)
  IN_PROGRESS // đang thực hiện
  COMPLETED // hoàn thành
  REJECTED // đội cứu hộ từ chối (kèm lý do), chờ admin xử lý
  DEFERRED // admin tiếp nhận đơn từ chối → tạm hoãn, sửa + gửi lại sau
  CANCELLED // admin huỷ nhiệm vụ (kèm lý do) — kết thúc luồng
}

// Kết quả giao vật tư tới hiện trường — đội cứu hộ xác nhận khi hoàn tất.
enum DeliveryOutcome {
  DELIVERED // giao đủ theo phương án
  PARTIAL // giao được một phần (thiếu/hỏng/không tiếp cận hết)
  FAILED // không giao được (đường tắc, điểm nạn di dời…)
}

enum MissionWarehouseRequestStatus {
  PENDING
  ACCEPTED
  PREPARED
  // Người đi lấy đã ký nhận. Tách khỏi PREPARED vì "kho đã soạn" và "hàng đã rời
  // kho" là hai việc khác nhau, và khoảng giữa hai việc đó là nơi hàng bị thiếu.
  PICKED_UP
}

// Nhiệm vụ cứu hộ — sinh từ tình huống, gồm nhu cầu + phương án phân bổ.
model Mission {
  id                    String                        @id @default(cuid())
  warehouseId           String
  warehouse             Warehouse                     @relation("MissionSourceWarehouse", fields: [warehouseId], references: [id])
  incidentType          String
  location              String?
  affectedPeople        Int
  durationHours         Int
  priority              String
  parsedInput           Json // JSON tình huống đã parse (từ AI hoặc nhập tay)
  reportText            String? // mô tả thô của trưởng thôn (mobile) — web đọc lại để tự điền + phân tích
  status                MissionStatus                 @default(DRAFT)
  fulfillment           Float                         @default(0) // mức đáp ứng % (min qua các loại)
  readinessAssessment   Json? // blocker + trạng thái + mức đáp ứng tại lúc lập phương án
  explanation           String? // giải thích AI (tiếng Việt)
  rejectionReason       String? // lý do đội cứu hộ từ chối (thiếu nhân lực/vật tư/xin trì hoãn) — admin đọc sau
  adminNote             String? // ghi chú admin khi tạm hoãn/gửi lại/huỷ — đội cứu hộ đọc
  deliveryOutcome       DeliveryOutcome? // kết quả giao hiện trường (đội cứu hộ xác nhận khi hoàn tất)
  deliveryNote          String? // ghi chú kết quả giao (vd: thiếu 20 áo phao, đường tắc phải giao điểm khác)
  completedAt           DateTime? // thời điểm đội cứu hộ xác nhận đã giao
  actionPlan            Json? // Incident Action Plan (8 mục, ActionPlanResponse từ AI)
  hamletId              String?
  hamlet                Hamlet?                       @relation(fields: [hamletId], references: [id], onDelete: SetNull)
  hamletName            String? // snapshot tên thôn lúc ADMIN lập phương án
  incidentLat           Float? // toạ độ điểm nạn (ghim tay) — tính khoảng cách kho gần nhất
  incidentLng           Float?
  createdByUserId       String?
  reportRequestId       String? // khóa retry do client gửi, chỉ có ý nghĩa trong scope người báo
  approvedByUserId      String?
  createdAt             DateTime                      @default(now())
  approvedAt            DateTime?
  requirements          MissionRequirement[]
  warehousePreparations MissionWarehousePreparation[]
  warehouseRequests     MissionWarehouseRequest[]
  analysisSnapshots     MissionAnalysisSnapshot[]
  fieldUpdates          MissionFieldUpdate[]

  @@unique([createdByUserId, reportRequestId])
  @@index([hamletId])
}

/// Immutable evidence of a human-reviewed coordination analysis. It captures
/// its exact inputs, output, provenance and version stamps, without assigning
/// people, contacting another commune, or mutating inventory.
enum MissionAnalysisSnapshotKind {
  BASELINE
  WHAT_IF
}

model MissionAnalysisSnapshot {
  id                     String                      @id @default(cuid())
  missionId              String
  mission                Mission                     @relation(fields: [missionId], references: [id], onDelete: Cascade)
  kind                   MissionAnalysisSnapshotKind
  requestId              String?
  fingerprint            String
  baselineSnapshotId     String?
  baselineSnapshot       MissionAnalysisSnapshot?    @relation("MissionAnalysisBaseline", fields: [baselineSnapshotId], references: [id], onDelete: SetNull)
  derivedSnapshots       MissionAnalysisSnapshot[]   @relation("MissionAnalysisBaseline")
  input                  Json
  provenance             Json
  result                 Json
  assumptions            Json?
  modelVersion           String
  ruleVersion            String
  geoRegistryVersion     String?
  routingGraphVersion    String?
  weatherSnapshotVersion String?
  actorId                String
  actor                  User                        @relation("MissionAnalysisActor", fields: [actorId], references: [id])
  computedAt             DateTime                    @default(now())
  expiresAt              DateTime?

  @@unique([missionId, requestId])
  @@index([missionId, kind, computedAt])
  @@index([baselineSnapshotId])
}

enum FieldUpdateInputMode {
  TEXT
  VOICE_TRANSCRIPT
}

/// A confirmed, idempotent field observation. The stored text is deliberately
/// limited to the operator-confirmed transcript; media and continuous tracking
/// are outside the product scope.
model MissionFieldUpdate {
  id               String               @id @default(cuid())
  missionId        String
  mission          Mission              @relation(fields: [missionId], references: [id], onDelete: Cascade)
  actorId          String
  actor            User                 @relation("MissionFieldUpdateActor", fields: [actorId], references: [id])
  requestId        String
  inputMode        FieldUpdateInputMode
  confirmedText    String
  clientCapturedAt DateTime?
  structuredIntent Json?
  intentProvenance Json?
  createdAt        DateTime             @default(now())

  @@unique([missionId, actorId, requestId])
  @@index([missionId, createdAt])
  @@index([actorId, createdAt])
}

// Nhu cầu vật tư của nhiệm vụ (sinh từ định mức).
model MissionRequirement {
  id                 String  @id @default(cuid())
  missionId          String
  mission            Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  sku                String
  itemName           String
  required           Int // số cần theo định mức
  allocated          Int // số cấp được từ kho (greedy)
  shortage           Int // thiếu = required - allocated
  unit               String
  allocations        Json // chi tiết phân bổ theo lô [{batchId, qty, expiryDate}]
  neighborSuggestion Json? // gợi ý mượn kho lân cận nếu thiếu [{name, distanceKm, available}]

  @@index([missionId])
}

// Tiến độ chuẩn bị/xuất kho của từng kho tham gia một nhiệm vụ đa kho.
// Một kho chỉ có thể claim một dòng duy nhất; preparedAt là dấu idempotency chống xuất trùng.
model MissionWarehousePreparation {
  id               String    @id @default(cuid())
  missionId        String
  mission          Mission   @relation(fields: [missionId], references: [id], onDelete: Cascade)
  warehouseId      String
  warehouse        Warehouse @relation(fields: [warehouseId], references: [id])
  preparedByUserId String?
  preparedBy       User?     @relation(fields: [preparedByUserId], references: [id], onDelete: SetNull)
  preparedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([missionId, warehouseId])
  @@index([warehouseId, preparedAt])
}

// Từng SKU mà một kho tham gia phải tiếp nhận và chuẩn bị cho nhiệm vụ.
// preparationClaimToken là CAS lock: ADMIN không thể sửa khi kho đang xuất.
model MissionWarehouseRequest {
  id                    String                        @id @default(cuid())
  missionId             String
  mission               Mission                       @relation(fields: [missionId], references: [id], onDelete: Cascade)
  warehouseId           String
  warehouse             Warehouse                     @relation(fields: [warehouseId], references: [id])
  sku                   String
  itemName              String
  unit                  String
  requestedQuantity     Int
  preparedQuantity      Int                           @default(0)
  allocations           Json
  preparedAllocations   Json?
  status                MissionWarehouseRequestStatus @default(PENDING)
  warehouseNote         String?
  adminNote             String?
  acceptedByUserId      String?
  acceptedBy            User?                         @relation("MissionWarehouseRequestAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  preparedByUserId      String?
  preparedBy            User?                         @relation("MissionWarehouseRequestPreparedBy", fields: [preparedByUserId], references: [id], onDelete: SetNull)
  preparationClaimToken String?
  preparationClaimedAt  DateTime?
  acceptedAt            DateTime?
  preparedAt            DateTime?
  // Xác nhận LẤY hàng. Để rỗng nghĩa là chưa ai ký nhận, khác hẳn với nhận đủ 0.
  pickedUpQuantity      Int?
  pickupNote            String?
  pickedUpByUserId      String?
  pickedUpBy            User?                         @relation("MissionWarehouseRequestPickedUpBy", fields: [pickedUpByUserId], references: [id], onDelete: SetNull)
  pickedUpAt            DateTime?
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt

  @@unique([missionId, warehouseId, sku])
  @@index([warehouseId, status, createdAt])
  @@index([missionId, status])
  @@index([preparationClaimToken])
}

// ===== Phase E: Incident Intelligence =====

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentState {
  OPEN // mới phát hiện
  ACKNOWLEDGED // đã tiếp nhận
  ASSIGNED // đã phân công
  RESOLVED // đã xử lý
}

// Sự cố do rule engine phát hiện từ hợp nhất sự kiện cảm biến.
model Incident {
  id                 String             @id @default(cuid())
  warehouseId        String
  sourceSubmissionId String?
  sourceSubmission   SensorSubmission?  @relation(fields: [sourceSubmissionId], references: [id], onDelete: SetNull)
  zoneId             String?
  kind               String // SUSPECTED_LOSS | SENSOR_FAULT | BAD_STORAGE | MISPLACED...
  severity           IncidentSeverity
  confidence         Float // 0..1 độ tin cậy kết luận
  title              String
  explanation        String? // LLM diễn đạt (tiếng Việt) — không tự kết luận số
  state              IncidentState      @default(OPEN)
  detectedAt         DateTime           @default(now())
  resolvedAt         DateTime?
  evidence           IncidentEvidence[]
  actions            IncidentAction[]
  emailOutbox        AlertEmailOutbox?

  @@index([warehouseId, state])
  @@index([sourceSubmissionId])
}

// Bằng chứng: từng sự kiện cảm biến góp phần vào kết luận (timeline).
model IncidentEvidence {
  id         String   @id @default(cuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  deviceCode String
  eventType  String
  value      Float
  weight     Float // trọng số đóng góp vào điểm nghiêm trọng
  occurredAt DateTime
  note       String?

  @@index([incidentId, occurredAt])
}

// Hành động xử lý sự cố (acknowledge/assign/resolve).
model IncidentAction {
  id             String   @id @default(cuid())
  incidentId     String
  incident       Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  action         String
  idempotencyKey String?
  actorId        String?
  note           String?
  createdAt      DateTime @default(now())

  @@unique([incidentId, idempotencyKey])
  @@index([incidentId])
}

enum AlertEmailStatus {
  PENDING
  SENDING
  SENT
}

// Outbox bền vững: trạng thái chuyển phát email, không quyết định trạng thái sự cố.
// Email gửi muộn luôn lấy observedAt/receivedAt ở đây để phân biệt với sentAt.
model AlertEmailOutbox {
  id              String           @id @default(cuid())
  incidentId      String           @unique
  incident        Incident         @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  warehouseId     String
  warehouse       Warehouse        @relation(fields: [warehouseId], references: [id])
  recipientEmails String[]         @default([])
  observedAt      DateTime
  receivedAt      DateTime
  status          AlertEmailStatus @default(PENDING)
  attempts        Int              @default(0)
  lastAttemptAt   DateTime?
  nextAttemptAt   DateTime         @default(now())
  lastError       String?
  sentAt          DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([status, nextAttemptAt])
  @@index([warehouseId, createdAt])
}

// Đếm số call API ngoài (Google Maps) theo tháng — chặn quota, không bị trừ tiền.
model ApiUsage {
  id        String   @id @default(cuid())
  provider  String // vd "google-routes"
  yearMonth String // "2026-07"
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([provider, yearMonth])
}

// Thông báo liên role (workflow cứu hộ) — đẩy realtime qua WebSocket theo role.
enum NotificationKind {
  MISSION_ASSIGNED // ADMIN sinh plan → báo cứu hộ
  RESCUE_CONFIRMED // cứu hộ xác nhận → báo kho
  WAREHOUSE_READY // kho chuẩn bị xong → báo admin + cứu hộ
  INTER_WAREHOUSE_REQUEST // thiếu → báo kho lân cận
  INCIDENT_DETECTED // sensor phát hiện sự cố → báo admin
  READINESS_DEGRADED // readiness rớt DEGRADED/CRITICAL → báo kho
  MISSION_REJECTED // đội cứu hộ từ chối nhiệm vụ (kèm lý do) → báo admin
  MISSION_DEFERRED // admin tiếp nhận đơn → tạm hoãn, báo đội cứu hộ
  MISSION_CANCELLED // admin huỷ nhiệm vụ (kèm lý do) → báo đội cứu hộ
  MISSION_COMPLETED // đội cứu hộ xác nhận đã giao (kèm kết quả) → báo admin + kho
  INCIDENT_REPORTED // trưởng thôn báo cáo tình huống từ hiện trường → báo admin
  FIELD_UPDATE_REPORTED // lực lượng hiện trường gửi evidence đã tự xác nhận → báo admin
  WAREHOUSE_REQUESTED // admin phát hành/cập nhật yêu cầu SKU → báo kho
  WAREHOUSE_REQUEST_ACCEPTED // kho xác nhận tiếp nhận một SKU → báo admin
  WAREHOUSE_REQUEST_REVIEW // kho báo thiếu/sai, cần admin xem lại
}

model Notification {
  id             String           @id @default(cuid())
  // Nullable only while legacy records are backfilled. Runtime reads never
  // expose a null-scoped record, so old data cannot leak across organizations.
  organizationId String?
  organization   Organization?    @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  recipientRole  UserRole // gửi theo role (WAREHOUSE/RESCUE/ADMIN)
  missionId      String?
  warehouseId    String?
  kind           NotificationKind
  title          String
  body           String
  read           Boolean          @default(false)
  // Deep-link target for ADMIN evidence review. It is a scalar by design so
  // notification retention never owns or deletes the immutable evidence.
  fieldUpdateId  String?          @unique
  createdAt      DateTime         @default(now())

  @@index([organizationId, recipientRole, read])
}

/// Chiều của một khoản mượn liên xã, xét TỪ PHÍA xã đang giữ bản ghi.
enum InterCommuneLoanDirection {
  OUTGOING // xã mình CHO xã khác mượn
  INCOMING // xã mình ĐI mượn của xã khác
}

enum InterCommuneLoanStatus {
  REQUESTED // đã gửi yêu cầu, chờ bên kia quyết
  REJECTED // bên cho mượn từ chối
  APPROVED // bên cho mượn đồng ý và đã trừ kho
  ACTIVE // bên mượn đã xác nhận nhận hàng — đang nợ
  PARTIALLY_RETURNED // đã trả một phần, còn nợ phần còn lại
  RETURNED // đã trả xong
  CANCELLED // bên yêu cầu tự huỷ trước khi có quyết định
}

/// Khoản mượn vật tư giữa hai xã.
///
/// Mỗi xã chạy một cơ sở dữ liệu RIÊNG, nên một khoản mượn tồn tại thành HAI bản
/// ghi — một ở mỗi xã, `direction` ngược nhau. Không có bản ghi dùng chung, vì
/// không có cơ sở dữ liệu dùng chung.
///
/// `peerLoanId` nối hai bản ghi đó lại khi tin đi được qua mạng. Mất mạng thì
/// trường này để trống và mỗi bên tự ghi tay theo thoả thuận qua điện thoại —
/// đúng cách hai xã vẫn làm với nhau từ trước tới nay, chỉ khác là nay có sổ.
///
/// Ghi theo SKU và số lượng chứ không trỏ tới lô cụ thể: lô là chuyện nội bộ của
/// mỗi kho, xã bên kia không biết và cũng không cần biết mã lô của xã này.
model InterCommuneLoan {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  direction InterCommuneLoanDirection
  status    InterCommuneLoanStatus    @default(REQUESTED)

  /// Tên xã bên kia, lưu nguyên văn: danh mục xã lân cận có thể đổi, nhưng sổ nợ
  /// thì phải đọc được y như lúc ghi.
  peerCommuneName String
  /// Id bản ghi tương ứng bên xã kia. Trống khi hai bên ghi tay lúc mất mạng.
  ///
  /// DUY NHẤT: hai bản ghi cùng trỏ về một khoản bên kia nghĩa là đã nhân đôi
  /// khoản nợ. Ràng buộc ở tầng CSDL vì đây là thứ phải đúng kể cả khi tin tới
  /// hai lần do gửi lại.
  peerLoanId      String? @unique

  /// Khoá chống nhận trùng cho yêu cầu tới từ xã kia.
  ///
  /// Đường truyền giữa hai xã là thứ hay đứt nhất trong cả hệ thống, nên xã gửi
  /// sẽ gửi lại. Không có khoá này thì mỗi lần gửi lại là một khoản mượn mới, và
  /// kho bên cho mượn bị trừ nhiều lần cho cùng một yêu cầu. Dự án đã dùng đúng
  /// cách này cho lô số liệu cảm biến và cho thao tác kho.
  inboundKey String? @unique

  itemSku  String
  itemName String
  /// Số lượng mượn theo thoả thuận.
  quantity Int
  /// Đã trả được bao nhiêu (cộng dồn).
  ///
  /// Trả TỪNG PHẦN là chuyện bình thường: mượn 200 chai, trả 180, hỏng mất 20.
  /// Mô hình mượn trong xã của chính dự án này đã có returnedOk/returnedDamaged/
  /// lost từ đầu; ghi nhận liên xã kiểu được-ăn-cả-ngã-về-không thì hoặc phải
  /// khai khống là đã trả đủ, hoặc để khoản nợ mở mãi mãi.
  returnedQuantity Int @default(0)
  unit     String

  /// Kho của xã mình chịu trách nhiệm cho khoản này (xuất ra hoặc nhận về).
  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])

  /// true khi bản ghi do người nhập tay vì lúc đó không gửi được qua mạng.
  recordedManually Boolean @default(false)
  // Việc chuyển kho ĐÃ HỨA nhưng chưa chắc đã xong.
  //
  // Sổ và kho nằm ở hai transaction khác nhau (inventory.export/import tự mở
  // transaction riêng), nên có một khe hẹp giữa lúc chốt sổ và lúc hàng thật sự
  // rời kho. Sập nguồn đúng khe đó thì sổ ghi đã chuyển mà hàng còn nguyên, và
  // không ai biết cho tới kỳ đối chiếu.
  //
  // Ghi lại đủ tham số để CHẠY LẠI. An toàn vì requestId bên trong là khoá chống
  // trùng của kho: chuyển rồi thì lần chạy lại không chuyển thêm lần nữa.
  pendingStockMove Json?

  note         String?
  rejectReason String?

  requestedAt DateTime  @default(now())
  decidedAt   DateTime?
  receivedAt  DateTime?
  returnedAt  DateTime?

  createdByUserId String?

  @@index([organizationId, direction, status])
  @@index([peerLoanId])
}
