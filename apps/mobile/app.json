{
  "expo": {
    "name": "Ứng phó nhanh",
    "slug": "safestock-mobile",
    "version": "0.5.1",
    "scheme": "safestock",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Dùng micro để ghi âm mô tả tình huống báo cáo cứu hộ."
      }
    },
    "android": {
      "package": "vn.ungphonhanh.safestock",
      "versionCode": 6,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": false
          }
        }
      ],
      "expo-asset",
      [
        "expo-camera",
        {
          "cameraPermission": "Cho phép Ứng phó nhanh dùng camera để quét mã QR vật tư và chụp ảnh bằng chứng khi báo kết quả nhiệm vụ.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép Ứng phó nhanh mở thư viện ảnh để gửi ảnh bằng chứng đã giao vật tư."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2f9e6e",
          "defaultChannel": "ung-pho-nhanh-nhiem-vu"
        }
      ]
    ],
    "web": {
      "bundler": "metro"
    }
  }
}
