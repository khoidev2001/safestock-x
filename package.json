{
  "name": "safestock-x",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "@tailwindcss/oxide",
      "sharp",
      "electron",
      "esbuild"
    ]
  },
  "scripts": {
    "infra:up": "docker compose --env-file .env -f infrastructure/docker-compose.yml up -d",
    "infra:down": "docker compose --env-file .env -f infrastructure/docker-compose.yml down",
    "infra:logs": "docker compose --env-file .env -f infrastructure/docker-compose.yml logs -f",
    "be:dev": "pnpm --filter @safestock/backend start:dev",
    "be:generate": "pnpm --filter @safestock/backend prisma:generate",
    "be:schema:diff": "pnpm --filter @safestock/backend prisma:diff",
    "be:schema": "pnpm --filter @safestock/backend prisma:push",
    "be:db": "pnpm be:generate && pnpm be:schema && pnpm --filter @safestock/backend seed",
    "fe:dev": "pnpm --filter @safestock/frontend dev",
    "desktop:dev": "pnpm --filter @safestock/desktop dev",
    "mobile:dev": "pnpm --filter @safestock/mobile start",
    "ai:dev": "cd apps/ai-service && .\\.venv\\Scripts\\python.exe -m uvicorn main:app --port 8000",
    "demo": "node apps/backend/demo/demo.mjs"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "socket.io-client": "^4.8.3",
    "typescript": "~6.0.3"
  }
}
