{
  "name": "safestock-x",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "pnpm": {
    "packageExtensions": {
      "@react-native-community/netinfo@11.4.1": {
        "peerDependencies": {
          "react": "*"
        }
      }
    },
    "overrides": {
      "@expo/cli>glob": "10.5.0",
      "@expo/cli>tar": "7.5.22",
      "@expo/config>glob": "10.5.0",
      "@expo/config-plugins>glob": "10.5.0",
      "@expo/metro-config>glob": "10.5.0",
      "@expo/metro-config>postcss": "8.5.23",
      "@expo/plist>@xmldom/xmldom": "0.8.13",
      "@nestjs/config>lodash": "4.18.1",
      "ajv>fast-uri": "3.1.4",
      "cacache@18.0.4>tar": "7.5.22",
      "brace-expansion": "file:./packages/brace-expansion-compat",
      "next>postcss": "8.5.23",
      "next>sharp": "0.35.3",
      "qs": "6.15.2",
      "uuid": "11.1.1"
    },
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "@tailwindcss/oxide",
      "sharp",
      "electron",
      "esbuild"
    ]
  },
  "scripts": {
    "infra:up": "docker compose --env-file .env -f infrastructure/docker-compose.yml up -d",
    "infra:down": "docker compose --env-file .env -f infrastructure/docker-compose.yml down",
    "infra:logs": "docker compose --env-file .env -f infrastructure/docker-compose.yml logs -f",
    "osrm:test": "node --test infrastructure/osrm/osrm-artifact.test.mjs infrastructure/osrm/osrm-operations.test.mjs infrastructure/osrm/osrm-runtime.test.mjs",
    "osrm:fetch": "node infrastructure/osrm/fetch-dong-xuan-osm.mjs",
    "osrm:build": "node infrastructure/osrm/manage-osrm.mjs build",
    "osrm:manifest": "node infrastructure/osrm/manage-osrm.mjs manifest",
    "osrm:preflight": "node infrastructure/osrm/manage-osrm.mjs preflight",
    "osrm:up": "node infrastructure/osrm/manage-osrm.mjs up",
    "osrm:down": "node infrastructure/osrm/manage-osrm.mjs down",
    "osrm:status": "node infrastructure/osrm/manage-osrm.mjs status",
    "osrm:logs": "node infrastructure/osrm/manage-osrm.mjs logs",
    "osrm:verify-live": "node infrastructure/osrm/manage-osrm.mjs verify-live",
    "osrm:verify-offline": "node infrastructure/osrm/manage-osrm.mjs verify-offline",
    "be:dev": "pnpm --filter @safestock/backend start:dev",
    "be:generate": "pnpm --filter @safestock/backend prisma:generate",
    "be:schema:diff": "pnpm --filter @safestock/backend prisma:diff",
    "be:schema": "pnpm --filter @safestock/backend prisma:push",
    "be:db": "pnpm be:generate && pnpm be:schema && pnpm --filter @safestock/backend seed",
    "fe:dev": "pnpm --filter @safestock/frontend dev",
    "desktop:dev": "pnpm --filter @safestock/desktop dev",
    "mobile:dev": "pnpm --filter @safestock/mobile start",
    "ai:dev": "node scripts/ai-dev.mjs",
    "dev:all": "node scripts/dev-all.mjs",
    "lint": "pnpm -r --if-present lint && eslint .",
    "lint:fix": "pnpm -r --if-present lint:fix && eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@types/react": "~19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "socket.io-client": "^4.8.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}
